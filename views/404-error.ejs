<%-include('partials/head')%>

<body class="bg-gray-100 flex items-center justify-center min-h-screen">

    <div class="text-center px-6">

        <!-- Big 404 -->
        <h1 class="text-9xl font-extrabold text-rose-500 tracking-widest">
            <%= pageTitle === 'Access Denied' ? '403' : '404' %>
        </h1>

        <!-- Divider -->
        <div class="w-24 h-1 bg-rose-500 mx-auto my-6 rounded"></div>

        <!-- Message -->
        <h2 class="text-3xl font-semibold text-gray-800 mb-4">
            <%= pageTitle === 'Access Denied' ? 'Access Denied' : 'Page Not Found' %>
        </h2>

        <p class="text-gray-600 mb-8 max-w-md mx-auto">
            <%= pageTitle === 'Access Denied' ? 'You are not allowed to access this page with this account type.' : "The page you're looking for doesn't exist or has been moved." %>
        </p>

        <!-- Button -->
        <a href="/"
           class="bg-rose-500 text-white px-6 py-3 rounded-full font-medium hover:bg-rose-600 transition shadow-md">
           Go Back Home
        </a>

    </div>

</body>
</html>
