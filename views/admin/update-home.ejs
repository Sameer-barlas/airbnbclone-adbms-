<%- include('../partials/head') %>

<body class="min-h-screen bg-slate-50 text-slate-950">
<%- include('../partials/navbar') %>

<main class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <section class="mb-8 rounded-[2rem] border border-white bg-gradient-to-br from-rose-50 via-white to-sky-50 p-8 shadow-sm lg:p-10">
        <p class="text-xs font-black uppercase tracking-[0.3em] text-rose-500">Host home</p>
        <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl"><%= editting ? 'Edit Home' : 'Add Home' %></h1>
        <p class="mt-3 max-w-2xl text-slate-600">Create a polished, guest-ready listing with clear pricing, amenities, location, and a strong cover image.</p>
    </section>

    <% if (errorMessage) { %>
        <div class="mb-6 rounded-2xl border border-rose-100 bg-rose-50 px-5 py-4 font-semibold text-rose-700"><%= errorMessage %></div>
    <% } %>

    <form action="<%= editting ? '/host/edit-home' : '/host/add-home' %>" method="POST" enctype="multipart/form-data" class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
        <% if (editting) { %>
            <input type="hidden" name="id" value="<%= currentHome.property_id %>">
        <% } %>

        <aside class="h-fit rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm lg:sticky lg:top-28">
            <label class="mb-3 block text-xs font-black uppercase tracking-widest text-slate-400">House Image</label>
            <div class="overflow-hidden rounded-[1.5rem] border border-slate-200 bg-gradient-to-br from-rose-100 via-amber-50 to-sky-100">
                <% if (currentHome && currentHome.imageUrl) { %>
                    <img src="<%= currentHome.imageUrl %>" alt="<%= currentHome.title %>" class="h-72 w-full object-cover">
                <% } else { %>
                    <div class="flex h-72 items-center justify-center px-8 text-center">
                        <div>
                            <p class="text-xs font-black uppercase tracking-[0.28em] text-rose-500">Cover photo</p>
                            <p class="mt-3 text-2xl font-black">Upload a premium first impression.</p>
                        </div>
                    </div>
                <% } %>
            </div>
            <div class="mt-4 rounded-3xl border border-dashed border-slate-300 bg-slate-50 p-4 transition hover:border-rose-200 hover:bg-rose-50">
                <input type="file" name="houseImage" accept="image/jpeg,image/png,image/webp" class="w-full text-sm file:mr-4 file:rounded-2xl file:border-0 file:bg-slate-950 file:px-5 file:py-3 file:font-black file:text-white">
                <p class="mt-3 text-xs font-semibold text-slate-400">Upload JPG, PNG, or WEBP. Max size: 5MB.</p>
            </div>
        </aside>

        <section class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/60 sm:p-8">
            <div class="space-y-7">
                <div>
                    <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Title</label>
                    <input type="text" name="title" value="<%= currentHome ? (currentHome.title || '') : '' %>" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
                </div>

                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    <div>
                        <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">City</label>
                        <select name="cityId" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
                            <option value="">Choose city</option>
                            <% cities.forEach(city => { %>
                                <option value="<%= city.city_id %>" <%= String(currentHome && (currentHome.city_id || currentHome.cityId)) === String(city.city_id) ? 'selected' : '' %>>
                                    <%= city.city_name %>, <%= city.country %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Home Type</label>
                        <select name="propertyType" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
                            <% propertyTypes.forEach(type => { %>
                                <option value="<%= type %>" <%= (currentHome && currentHome.property_type === type) || (currentHome && currentHome.propertyType === type) ? 'selected' : '' %>><%= type %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
                    <div>
                        <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Price / Night</label>
                        <input type="number" min="1" name="pricePerNight" value="<%= currentHome ? (currentHome.price_per_night || currentHome.pricePerNight || '') : '' %>" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
                    </div>
                    <div>
                        <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Max Guests</label>
                        <input type="number" min="1" max="50" name="maxGuests" value="<%= currentHome ? (currentHome.max_guests || currentHome.maxGuests || 1) : 1 %>" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
                    </div>
                    <div>
                        <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Rooms</label>
                        <input type="number" min="1" name="totalRooms" value="<%= currentHome ? (currentHome.total_rooms || currentHome.totalRooms || 1) : 1 %>" required class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    <div>
                        <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Latitude</label>
                        <input type="number" step="0.000001" name="latitude" value="<%= currentHome ? (currentHome.latitude || '') : '' %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
                    </div>
                    <div>
                        <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Longitude</label>
                        <input type="number" step="0.000001" name="longitude" value="<%= currentHome ? (currentHome.longitude || '') : '' %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
                    </div>
                </div>

                <div>
                    <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Description</label>
                    <textarea name="description" rows="5" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100"><%= currentHome ? (currentHome.description || '') : '' %></textarea>
                </div>

                <div>
                    <label class="mb-3 block text-xs font-black uppercase tracking-widest text-slate-400">Amenities</label>
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
                        <% amenities.forEach(amenity => { %>
                            <label class="cursor-pointer rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold transition has-[:checked]:border-rose-300 has-[:checked]:bg-rose-50 has-[:checked]:text-rose-600 hover:border-rose-200">
                                <input type="checkbox" name="amenityIds" value="<%= amenity.amenity_id %>" class="mr-2" <%= selectedAmenities.includes(String(amenity.amenity_id)) ? 'checked' : '' %>>
                                <%= amenity.name %>
                            </label>
                        <% }) %>
                    </div>
                </div>

                <button class="w-full rounded-2xl bg-slate-950 py-4 font-black text-white shadow-xl shadow-slate-200 transition hover:-translate-y-1 hover:bg-rose-500 hover:shadow-rose-200">
                    <%= editting ? 'Update Home' : 'Create Home' %>
                </button>
            </div>
        </section>
    </form>
</main>

</body>
</html>
