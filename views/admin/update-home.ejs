<%- include('../partials/head') %>

<body class="min-h-screen bg-gradient-to-br from-slate-100 via-sky-50/70 to-orange-50/60 text-slate-950">
<%- include('../partials/navbar') %>

<main class="relative overflow-hidden">
    <% const formCities = Array.isArray(cities) ? cities : []; %>
    <% const formAmenities = Array.isArray(amenities) ? amenities : []; %>
    <% const formPropertyTypes = Array.isArray(propertyTypes) ? propertyTypes : []; %>
    <% const selectedAmenityValues = (Array.isArray(selectedAmenities) ? selectedAmenities : []).map(String); %>
    <% const selectedCityId = currentHome ? String(currentHome.city_id || currentHome.cityId || '') : ''; %>
    <% const canSaveHome = formCities.length > 0; %>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,rgba(244,63,94,0.055),transparent_30%),radial-gradient(circle_at_85%_25%,rgba(251,146,60,0.11),transparent_32%),radial-gradient(circle_at_52%_75%,rgba(14,165,233,0.12),transparent_36%)]"></div>
    <div class="pointer-events-none absolute -left-28 top-20 h-96 w-96 rounded-full bg-rose-200/45 blur-3xl animate-float-slow"></div>
    <div class="pointer-events-none absolute right-0 top-80 h-96 w-96 rounded-full bg-cyan-100/50 blur-3xl animate-float-slow"></div>
    <div class="pointer-events-none absolute bottom-32 left-1/2 h-80 w-80 rounded-full bg-orange-200/40 blur-3xl"></div>

    <section class="relative z-10 mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <section class="mb-8 overflow-hidden rounded-[2.75rem] border border-white bg-gradient-to-br from-slate-950 via-slate-900 to-rose-950 p-6 text-white shadow-2xl shadow-slate-300/70 sm:p-8 lg:p-10 animate-gradient-x">
            <div class="relative grid gap-8 lg:grid-cols-[1fr_300px] lg:items-end">
                <div class="animate-slide-in-left">
                    <span class="inline-flex rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.28em] text-rose-200 backdrop-blur">Host onboarding</span>
                    <h1 class="mt-5 text-5xl font-black tracking-tight sm:text-6xl"><%= editting ? 'Update your listing' : 'Create a premium listing' %></h1>
                    <p class="mt-4 max-w-2xl leading-8 text-white/68">Build a guest-ready home profile with clear pricing, accurate capacity, amenities, and a strong cover image.</p>
                </div>
                <div class="animate-slide-in-right rounded-[1.75rem] border border-white/15 bg-white/10 p-5 backdrop-blur">
                    <p class="text-xs font-black uppercase tracking-widest text-white/50">Listing tips</p>
                    <ul class="mt-3 space-y-2 text-sm font-semibold text-white/75">
                        <li>Use a clear title</li>
                        <li>Add accurate price</li>
                        <li>Keep availability updated</li>
                    </ul>
                </div>
            </div>
        </section>

        <% if (errorMessage) { %>
            <div class="mb-6 rounded-2xl border border-rose-100 bg-rose-50 px-5 py-4 font-semibold text-rose-700 shadow-sm"><%= errorMessage %></div>
        <% } %>

        <form action="<%= editting ? '/host/edit-home' : '/host/add-home' %>" method="POST" enctype="multipart/form-data" class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
            <% if (editting) { %>
                <input type="hidden" name="id" value="<%= currentHome.property_id %>">
            <% } %>

            <aside class="h-fit rounded-[2rem] border border-white bg-white/85 p-5 shadow-2xl shadow-slate-200/70 backdrop-blur-xl lg:sticky lg:top-28">
                <label class="mb-3 block text-xs font-black uppercase tracking-widest text-slate-400">House Image</label>
                <div class="overflow-hidden rounded-[1.5rem] border border-slate-200 bg-gradient-to-br from-rose-100 via-amber-50 to-sky-100">
                    <% if (currentHome && currentHome.imageUrl) { %>
                        <img src="<%= currentHome.imageUrl %>" alt="<%= currentHome.title %>" class="h-72 w-full object-cover">
                    <% } else { %>
                        <div class="relative flex h-72 items-center justify-center px-8 text-center">
                            <div class="absolute inset-0 animate-shimmer"></div>
                            <div class="relative">
                                <p class="text-xs font-black uppercase tracking-[0.28em] text-rose-500">Cover photo</p>
                                <p class="mt-3 text-2xl font-black">Upload a premium first impression.</p>
                            </div>
                        </div>
                    <% } %>
                </div>
                <div class="mt-4 rounded-3xl border border-dashed border-slate-300 bg-slate-50/80 p-4 transition hover:border-rose-200 hover:bg-rose-50">
                    <input type="file" name="houseImage" accept="image/jpeg,image/png,image/webp" class="w-full text-sm file:mr-4 file:rounded-2xl file:border-0 file:bg-slate-950 file:px-5 file:py-3 file:font-black file:text-white file:transition hover:file:bg-rose-500">
                    <p class="mt-3 text-xs font-semibold text-slate-400">Upload JPG, PNG, or WEBP. Max size: 5MB.</p>
                </div>
            </aside>

            <section class="rounded-[2rem] border border-white bg-white/90 p-6 shadow-2xl shadow-slate-200/70 backdrop-blur-xl sm:p-8">
                <div class="space-y-7">
                    <div>
                        <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Title</label>
                        <input type="text" name="title" value="<%= currentHome ? (currentHome.title || '') : '' %>" required class="w-full rounded-2xl border border-slate-200 bg-white/80 px-5 py-4 font-semibold outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                        <p class="mt-2 text-xs font-semibold text-slate-400">Use a short, memorable title guests can scan quickly.</p>
                    </div>

                    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                        <div>
                            <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">City</label>
                            <select name="cityId" required <%= canSaveHome ? '' : 'disabled' %> class="w-full rounded-2xl border border-slate-200 bg-white/80 px-5 py-4 pr-12 font-semibold outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-400">
                                <option value=""><%= canSaveHome ? 'Choose city' : 'No cities available' %></option>
                                <% formCities.forEach(city => { %>
                                    <option value="<%= city.city_id %>" <%= selectedCityId === String(city.city_id) ? 'selected' : '' %>>
                                        <%= city.city_name %>, <%= city.country %>
                                    </option>
                                <% }) %>
                            </select>
                            <% if (!canSaveHome) { %>
                                <p class="mt-2 text-xs font-semibold text-rose-500">Add rows to the cities table, then reload this form.</p>
                            <% } %>
                        </div>
                        <div>
                            <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Home Type</label>
                            <select name="propertyType" required class="w-full rounded-2xl border border-slate-200 bg-white/80 px-5 py-4 pr-12 font-semibold outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                                <% formPropertyTypes.forEach(type => { %>
                                    <option value="<%= type %>" <%= (currentHome && currentHome.property_type === type) || (currentHome && currentHome.propertyType === type) ? 'selected' : '' %>><%= type %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
                        <div>
                            <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Price / Night</label>
                            <input type="number" min="1" name="pricePerNight" value="<%= currentHome ? (currentHome.price_per_night || currentHome.pricePerNight || '') : '' %>" required class="w-full rounded-2xl border border-slate-200 bg-white/80 px-5 py-4 font-semibold outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                        </div>
                        <div>
                            <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Max Guests</label>
                            <input type="number" min="1" max="50" name="maxGuests" value="<%= currentHome ? (currentHome.max_guests || currentHome.maxGuests || 1) : 1 %>" required class="w-full rounded-2xl border border-slate-200 bg-white/80 px-5 py-4 font-semibold outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                        </div>
                        <div>
                            <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Rooms</label>
                            <input type="number" min="1" name="totalRooms" value="<%= currentHome ? (currentHome.total_rooms || currentHome.totalRooms || 1) : 1 %>" required class="w-full rounded-2xl border border-slate-200 bg-white/80 px-5 py-4 font-semibold outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                        <div>
                            <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Latitude</label>
                            <input type="number" step="0.000001" name="latitude" value="<%= currentHome ? (currentHome.latitude || '') : '' %>" class="w-full rounded-2xl border border-slate-200 bg-white/80 px-5 py-4 font-semibold outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                        </div>
                        <div>
                            <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Longitude</label>
                            <input type="number" step="0.000001" name="longitude" value="<%= currentHome ? (currentHome.longitude || '') : '' %>" class="w-full rounded-2xl border border-slate-200 bg-white/80 px-5 py-4 font-semibold outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                        </div>
                    </div>

                    <div>
                        <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-400">Description</label>
                        <textarea name="description" rows="5" class="w-full rounded-2xl border border-slate-200 bg-white/80 px-5 py-4 font-semibold outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100"><%= currentHome ? (currentHome.description || '') : '' %></textarea>
                    </div>

                    <div>
                        <label class="mb-3 block text-xs font-black uppercase tracking-widest text-slate-400">Amenities</label>
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
                            <% if (formAmenities.length === 0) { %>
                                <p class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-500 sm:col-span-2 xl:col-span-3">No amenities found. Add amenities in MySQL if you want hosts to tag listings.</p>
                            <% } %>
                            <% formAmenities.forEach(amenity => { %>
                                <label class="cursor-pointer rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 text-sm font-bold transition has-[:checked]:border-rose-300 has-[:checked]:bg-rose-50 has-[:checked]:text-rose-600 hover:border-rose-200 hover:bg-rose-50">
                                    <input type="checkbox" name="amenityIds" value="<%= amenity.amenity_id %>" class="mr-2 accent-rose-500" <%= selectedAmenityValues.includes(String(amenity.amenity_id)) ? 'checked' : '' %>>
                                    <%= amenity.name %>
                                </label>
                            <% }) %>
                        </div>
                    </div>

                    <button <%= canSaveHome ? '' : 'disabled' %> class="w-full rounded-2xl bg-rose-500 py-4 font-black text-white shadow-xl shadow-rose-100 transition hover:-translate-y-1 hover:bg-rose-600 hover:shadow-rose-200 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:shadow-none disabled:hover:translate-y-0">
                        <%= editting ? 'Update Home' : 'Create Home' %>
                    </button>
                </div>
            </section>
        </form>
    </section>
</main>

</body>
</html>
