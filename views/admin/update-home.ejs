<%- include('../partials/head') %>

<body class="min-h-screen bg-slate-50 text-slate-900">
<%- include('../partials/navbar') %>

<main class="max-w-3xl mx-auto px-6 py-10">
    <div class="mb-8 text-center">
        <p class="text-xs font-black uppercase tracking-[0.3em] text-rose-500">Host home</p>
        <h1 class="text-4xl font-black mt-2"><%= editting ? 'Edit Home' : 'Add Home' %></h1>
        <p class="text-slate-500 mt-2">Create a polished listing for guests to discover.</p>
    </div>

    <% if (errorMessage) { %>
        <div class="mb-6 rounded-2xl border border-rose-100 bg-rose-50 px-5 py-4 text-rose-700 font-semibold"><%= errorMessage %></div>
    <% } %>

    <form action="<%= editting ? '/host/edit-home' : '/host/add-home' %>" method="POST" enctype="multipart/form-data" class="bg-white border border-slate-200 rounded-[2rem] shadow-xl p-8 space-y-5">
        <% if (editting) { %>
            <input type="hidden" name="id" value="<%= currentHome.property_id %>">
        <% } %>

        <div>
            <label class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-1">Title</label>
            <input type="text" name="title" value="<%= currentHome ? (currentHome.title || '') : '' %>" required class="w-full rounded-2xl border border-slate-200 px-5 py-4 focus:outline-none focus:ring-4 focus:ring-rose-100">
        </div>

        <div>
            <label class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-2">House Image</label>
            <% if (currentHome && currentHome.imageUrl) { %>
                <img src="<%= currentHome.imageUrl %>" alt="<%= currentHome.title %>" class="mb-3 h-48 w-full rounded-3xl object-cover border border-slate-200">
            <% } %>
            <input type="file" name="houseImage" accept="image/jpeg,image/png,image/webp" class="w-full rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-5 py-4 file:mr-4 file:rounded-xl file:border-0 file:bg-slate-900 file:px-4 file:py-2 file:font-bold file:text-white">
            <p class="text-xs text-slate-400 mt-2">Upload JPG, PNG, or WEBP. Max size: 5MB.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-1">City</label>
                <select name="cityId" required class="w-full rounded-2xl border border-slate-200 px-5 py-4 focus:outline-none focus:ring-4 focus:ring-rose-100">
                    <option value="">Choose city</option>
                    <% cities.forEach(city => { %>
                        <option value="<%= city.city_id %>" <%= String(currentHome && (currentHome.city_id || currentHome.cityId)) === String(city.city_id) ? 'selected' : '' %>>
                            <%= city.city_name %>, <%= city.country %>
                        </option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-1">Home Type</label>
                <select name="propertyType" required class="w-full rounded-2xl border border-slate-200 px-5 py-4 focus:outline-none focus:ring-4 focus:ring-rose-100">
                    <% propertyTypes.forEach(type => { %>
                        <option value="<%= type %>" <%= (currentHome && currentHome.property_type === type) || (currentHome && currentHome.propertyType === type) ? 'selected' : '' %>><%= type %></option>
                    <% }) %>
                </select>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <div>
                <label class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-1">Price / Night</label>
                <input type="number" min="1" name="pricePerNight" value="<%= currentHome ? (currentHome.price_per_night || currentHome.pricePerNight || '') : '' %>" required class="w-full rounded-2xl border border-slate-200 px-5 py-4 focus:outline-none focus:ring-4 focus:ring-rose-100">
            </div>
            <div>
                <label class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-1">Max Guests</label>
                <input type="number" min="1" max="50" name="maxGuests" value="<%= currentHome ? (currentHome.max_guests || currentHome.maxGuests || 1) : 1 %>" required class="w-full rounded-2xl border border-slate-200 px-5 py-4 focus:outline-none focus:ring-4 focus:ring-rose-100">
            </div>
            <div>
                <label class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-1">Rooms</label>
                <input type="number" min="1" name="totalRooms" value="<%= currentHome ? (currentHome.total_rooms || currentHome.totalRooms || 1) : 1 %>" required class="w-full rounded-2xl border border-slate-200 px-5 py-4 focus:outline-none focus:ring-4 focus:ring-rose-100">
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                <label class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-1">Latitude</label>
                <input type="number" step="0.000001" name="latitude" value="<%= currentHome ? (currentHome.latitude || '') : '' %>" class="w-full rounded-2xl border border-slate-200 px-5 py-4 focus:outline-none focus:ring-4 focus:ring-rose-100">
            </div>
            <div>
                <label class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-1">Longitude</label>
                <input type="number" step="0.000001" name="longitude" value="<%= currentHome ? (currentHome.longitude || '') : '' %>" class="w-full rounded-2xl border border-slate-200 px-5 py-4 focus:outline-none focus:ring-4 focus:ring-rose-100">
            </div>
        </div>

        <div>
            <label class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-1">Description</label>
            <textarea name="description" rows="4" class="w-full rounded-2xl border border-slate-200 px-5 py-4 focus:outline-none focus:ring-4 focus:ring-rose-100"><%= currentHome ? (currentHome.description || '') : '' %></textarea>
        </div>

        <div>
            <label class="block text-xs font-black uppercase tracking-widest text-slate-400 mb-2">Amenities</label>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                <% amenities.forEach(amenity => { %>
                    <label class="rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold cursor-pointer has-[:checked]:bg-rose-50 has-[:checked]:border-rose-300">
                        <input type="checkbox" name="amenityIds" value="<%= amenity.amenity_id %>" class="mr-2" <%= selectedAmenities.includes(String(amenity.amenity_id)) ? 'checked' : '' %>>
                        <%= amenity.name %>
                    </label>
                <% }) %>
            </div>
        </div>

        <button class="w-full bg-slate-900 text-white py-4 rounded-2xl font-black hover:bg-slate-800 transition">
            <%= editting ? 'Update Home' : 'Create Home' %>
        </button>
    </form>
</main>

</body>
</html>
