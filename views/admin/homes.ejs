<%- include('../partials/head') %>

<body class="min-h-screen bg-gradient-to-br from-slate-100 via-sky-50/70 to-orange-50/60 text-slate-950">
<%- include('../partials/navbar') %>

<main class="relative overflow-hidden">
    <% const formatDate = value => { const date = new Date(value); return Number.isNaN(date.getTime()) ? value : date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }); }; %>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,rgba(244,63,94,0.055),transparent_30%),radial-gradient(circle_at_85%_25%,rgba(251,146,60,0.11),transparent_32%),radial-gradient(circle_at_52%_75%,rgba(14,165,233,0.12),transparent_36%)]"></div>
    <div class="pointer-events-none absolute -left-28 top-24 h-96 w-96 rounded-full bg-rose-200/45 blur-3xl animate-float-slow"></div>
    <div class="pointer-events-none absolute right-0 top-96 h-96 w-96 rounded-full bg-sky-200/40 blur-3xl animate-float-slow"></div>
    <div class="pointer-events-none absolute bottom-40 left-1/2 h-80 w-80 rounded-full bg-amber-100/80 blur-3xl"></div>

    <section class="relative mx-auto max-w-7xl px-4 pt-10 sm:px-6">
        <div class="relative overflow-hidden rounded-[2.75rem] border border-white bg-gradient-to-br from-slate-950 via-slate-900 to-rose-950 p-6 text-white shadow-2xl shadow-slate-300/70 sm:p-8 lg:p-10 animate-gradient-x">
            <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-rose-500/25 blur-3xl"></div>
            <div class="absolute bottom-0 left-1/3 h-64 w-64 rounded-full bg-sky-400/15 blur-3xl"></div>
            <div class="relative grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
                <div class="animate-slide-in-left">
                    <span class="inline-flex rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.28em] text-rose-200 backdrop-blur">Host studio</span>
                    <h1 class="mt-5 max-w-3xl text-5xl font-black tracking-tight sm:text-6xl">Manage your homes with a premium control room.</h1>
                    <p class="mt-5 max-w-2xl leading-8 text-white/68">Track listings, revenue, bookings, and availability from one polished workspace while keeping your existing host flow exactly the same.</p>
                </div>
                <div class="animate-slide-in-right rounded-[2rem] border border-white/15 bg-white/10 p-4 backdrop-blur">
                    <div class="rounded-[1.5rem] bg-white p-5 text-slate-950 shadow-2xl shadow-slate-950/20">
                        <p class="text-xs font-black uppercase tracking-[0.25em] text-rose-500">Host actions</p>
                        <p class="mt-3 text-sm font-semibold leading-6 text-slate-500">Add a new property, update availability, or review booking performance.</p>
                        <a href="/host/add-home" class="mt-5 inline-flex w-full justify-center rounded-2xl bg-rose-500 px-6 py-4 font-black text-white shadow-xl shadow-rose-100 transition hover:-translate-y-1 hover:bg-rose-600">
                            Add Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="relative z-10 mx-auto max-w-7xl px-4 py-10 sm:px-6">
        <% if (message) { %>
            <div class="mb-6 rounded-2xl border border-emerald-100 bg-emerald-50 px-5 py-4 font-semibold text-emerald-700 shadow-sm"><%= message %></div>
        <% } %>

        <div class="reveal-on-scroll mb-10 grid grid-cols-2 gap-4 lg:grid-cols-5">
            <div class="group overflow-hidden rounded-[1.7rem] border border-white bg-white p-5 shadow-xl shadow-slate-200/60 transition hover:-translate-y-1 hover:shadow-2xl">
                <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-rose-50 font-black text-rose-500">H</div>
                <p class="text-xs font-black uppercase tracking-widest text-slate-400">Homes</p>
                <p class="mt-2 text-3xl font-black"><%= dashboard ? dashboard.total_properties : 0 %></p>
            </div>
            <div class="group overflow-hidden rounded-[1.7rem] border border-white bg-white p-5 shadow-xl shadow-slate-200/60 transition hover:-translate-y-1 hover:shadow-2xl">
                <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-50 font-black text-sky-600">B</div>
                <p class="text-xs font-black uppercase tracking-widest text-slate-400">Bookings</p>
                <p class="mt-2 text-3xl font-black"><%= dashboard ? dashboard.total_bookings : 0 %></p>
            </div>
            <div class="group overflow-hidden rounded-[1.7rem] border border-white bg-white p-5 shadow-xl shadow-slate-200/60 transition hover:-translate-y-1 hover:shadow-2xl">
                <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 font-black text-emerald-600">R</div>
                <p class="text-xs font-black uppercase tracking-widest text-slate-400">Revenue</p>
                <p class="mt-2 text-2xl font-black">PKR <%= dashboard ? dashboard.total_revenue : 0 %></p>
            </div>
            <div class="group overflow-hidden rounded-[1.7rem] border border-white bg-white p-5 shadow-xl shadow-slate-200/60 transition hover:-translate-y-1 hover:shadow-2xl">
                <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 font-black text-amber-600">S</div>
                <p class="text-xs font-black uppercase tracking-widest text-slate-400">Rating</p>
                <p class="mt-2 text-3xl font-black"><%= dashboard && dashboard.avg_rating ? dashboard.avg_rating : '0.00' %></p>
            </div>
            <div class="group overflow-hidden rounded-[1.7rem] border border-white bg-white p-5 shadow-xl shadow-slate-200/60 transition hover:-translate-y-1 hover:shadow-2xl">
                <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-50 font-black text-violet-600">V</div>
                <p class="text-xs font-black uppercase tracking-widest text-slate-400">Reviews</p>
                <p class="mt-2 text-3xl font-black"><%= dashboard ? dashboard.total_reviews : 0 %></p>
            </div>
        </div>

        <section class="reveal-on-scroll mb-10">
            <div class="mb-6 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
                <div>
                    <p class="text-xs font-black uppercase tracking-[0.28em] text-rose-500">Listings</p>
                    <h2 class="mt-2 text-4xl font-black tracking-tight">Your homes</h2>
                </div>
                <p class="max-w-lg text-sm font-semibold leading-6 text-slate-500">Open or block availability dates, edit property information, and keep booked homes protected from deletion.</p>
            </div>

            <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">
                <% if (!registeredHomes || registeredHomes.length === 0) { %>
                    <div class="col-span-full rounded-[2rem] border border-dashed border-slate-300 bg-white p-12 text-center shadow-xl shadow-slate-200/60">
                        <h3 class="text-2xl font-black">No homes yet</h3>
                        <p class="mt-2 text-slate-500">Add cities and amenities in MySQL, then create your first home.</p>
                    </div>
                <% } %>

                <% registeredHomes.forEach(home => { %>
                    <article class="group overflow-hidden rounded-[2.25rem] border border-white bg-white shadow-xl shadow-slate-200/70 transition duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-rose-100/70">
                        <div class="relative h-60 overflow-hidden bg-gradient-to-br from-rose-100 via-amber-50 to-sky-100">
                            <% if (home.imageUrl) { %>
                                <img src="<%= home.imageUrl %>" alt="<%= home.title %>" class="h-full w-full object-cover transition duration-700 group-hover:scale-110">
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/15 to-transparent"></div>
                            <% } else { %>
                                <div class="absolute inset-0 premium-shimmer opacity-60"></div>
                            <% } %>
                            <h3 class="absolute inset-x-5 bottom-5 text-2xl font-black <%= home.imageUrl ? 'text-white drop-shadow' : 'text-slate-950' %>"><%= home.title %></h3>
                            <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-rose-500 shadow-sm"><%= home.property_type %></span>
                            <span class="absolute right-4 top-4 rounded-full bg-slate-950/90 px-3 py-1.5 text-xs font-black text-white">PKR <%= home.price_per_night %></span>
                        </div>

                        <div class="space-y-4 p-6">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <p class="font-bold text-slate-500"><%= home.city_name %>, <%= home.country %></p>
                                    <p class="mt-1 text-sm font-semibold text-slate-400"><%= home.max_guests %> guests</p>
                                </div>
                                <span class="rounded-full bg-rose-50 px-3 py-1 text-xs font-black text-rose-500"><%= home.avg_rating || '0.00' %> rating</span>
                            </div>

                            <% if (home.active_booking_count > 0) { %>
                                <p class="rounded-2xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm font-bold text-amber-700">
                                    <%= home.active_booking_count %> active booking(s). Delete is locked.
                                </p>
                            <% } %>

                            <div class="grid grid-cols-2 gap-3">
                                <a href="/host/edit-home/<%= home.property_id %>?editing=true" class="rounded-2xl bg-slate-950 py-3 text-center font-black text-white transition hover:-translate-y-0.5 hover:bg-slate-800">Edit</a>
                                <% if (home.active_booking_count > 0) { %>
                                    <button type="button" disabled class="w-full cursor-not-allowed rounded-2xl border border-slate-200 bg-slate-50 py-3 font-black text-slate-400">Delete</button>
                                <% } else { %>
                                    <form action="/host/delete-home" method="POST">
                                        <input type="hidden" name="id" value="<%= home.property_id %>">
                                        <button class="w-full rounded-2xl border border-rose-200 py-3 font-black text-rose-600 transition hover:-translate-y-0.5 hover:bg-rose-50">Delete</button>
                                    </form>
                                <% } %>
                            </div>

                            <form action="/host/availability" method="POST" class="grid grid-cols-1 gap-3 rounded-[1.75rem] border border-slate-100 bg-slate-50 p-4 sm:grid-cols-[1fr_auto]">
                                <input type="hidden" name="propertyId" value="<%= home.property_id %>">
                                <input type="date" name="availableDate" required class="rounded-2xl border border-slate-200 bg-white px-3 py-3 font-semibold outline-none transition focus:border-rose-300 focus:ring-4 focus:ring-rose-100">
                                <select name="isBlocked" class="rounded-2xl border border-slate-200 bg-white px-3 py-3 font-semibold outline-none transition focus:border-rose-300 focus:ring-4 focus:ring-rose-100">
                                    <option value="1">Block</option>
                                    <option value="0">Open</option>
                                </select>
                                <button class="sm:col-span-2 rounded-2xl bg-rose-50 py-3 font-black text-rose-600 transition hover:-translate-y-0.5 hover:bg-rose-100">Update Availability</button>
                            </form>
                        </div>
                    </article>
                <% }) %>
            </div>
        </section>

        <section class="reveal-on-scroll grid grid-cols-1 gap-8 lg:grid-cols-2">
            <div class="rounded-[2rem] border border-white bg-white/95 p-6 shadow-xl shadow-slate-200/60 backdrop-blur">
                <div class="mb-5 flex items-center justify-between gap-4">
                    <div>
                        <p class="text-xs font-black uppercase tracking-widest text-rose-500">Analytics</p>
                        <h2 class="text-2xl font-black">Revenue Report</h2>
                    </div>
                </div>
                <div class="space-y-3">
                    <% if (!revenueReport || revenueReport.length === 0) { %>
                        <p class="rounded-2xl bg-slate-50 p-5 text-slate-500">No revenue yet this year.</p>
                    <% } %>
                    <% revenueReport.forEach(row => { %>
                        <div class="flex items-center justify-between rounded-2xl bg-slate-50 px-4 py-3 transition hover:bg-rose-50">
                            <span class="font-bold text-slate-600"><%= row.month_name %></span>
                            <span class="font-black text-slate-950">PKR <%= row.gross_revenue %></span>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="rounded-[2rem] border border-white bg-white/95 p-6 shadow-xl shadow-slate-200/60 backdrop-blur">
                <div class="mb-5">
                    <p class="text-xs font-black uppercase tracking-widest text-rose-500">Activity</p>
                    <h2 class="text-2xl font-black">Recent Host Bookings</h2>
                </div>
                <div class="space-y-3">
                    <% if (!hostBookings || hostBookings.length === 0) { %>
                        <p class="rounded-2xl bg-slate-50 p-5 text-slate-500">No bookings yet.</p>
                    <% } %>
                    <% hostBookings.slice(0, 6).forEach(book => { %>
                        <div class="rounded-2xl bg-slate-50 px-4 py-3 transition hover:bg-rose-50">
                            <p class="font-black"><%= book.property_title %></p>
                            <p class="mt-1 text-sm font-semibold text-slate-500"><%= book.guest_name %> | <%= formatDate(book.check_in) %> to <%= formatDate(book.check_out) %> | <%= book.status %></p>
                        </div>
                    <% }) %>
                </div>
            </div>
        </section>
    </section>
</main>

</body>
</html>
