<%- include('../partials/head') %>

<body class="min-h-screen bg-slate-50 text-slate-900">
<%- include('../partials/navbar') %>

<main class="max-w-7xl mx-auto px-6 py-10">
    <div class="mb-8 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
        <div>
            <p class="text-xs font-black uppercase tracking-[0.3em] text-rose-500">Host dashboard</p>
            <h1 class="text-4xl font-black mt-2">Manage your homes</h1>
        </div>
        <a href="/host/add-home" class="bg-rose-500 text-white px-6 py-3 rounded-2xl font-black hover:bg-rose-600 transition">Add Home</a>
    </div>

    <% if (message) { %>
        <div class="mb-6 rounded-2xl border border-emerald-100 bg-emerald-50 px-5 py-4 text-emerald-700 font-semibold"><%= message %></div>
    <% } %>

    <section class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-10">
        <div class="bg-white rounded-3xl border border-slate-200 p-5">
            <p class="text-xs font-black uppercase text-slate-400">Homes</p>
            <p class="text-3xl font-black mt-2"><%= dashboard ? dashboard.total_properties : 0 %></p>
        </div>
        <div class="bg-white rounded-3xl border border-slate-200 p-5">
            <p class="text-xs font-black uppercase text-slate-400">Bookings</p>
            <p class="text-3xl font-black mt-2"><%= dashboard ? dashboard.total_bookings : 0 %></p>
        </div>
        <div class="bg-white rounded-3xl border border-slate-200 p-5">
            <p class="text-xs font-black uppercase text-slate-400">Revenue</p>
            <p class="text-3xl font-black mt-2">PKR <%= dashboard ? dashboard.total_revenue : 0 %></p>
        </div>
        <div class="bg-white rounded-3xl border border-slate-200 p-5">
            <p class="text-xs font-black uppercase text-slate-400">Rating</p>
            <p class="text-3xl font-black mt-2"><%= dashboard && dashboard.avg_rating ? dashboard.avg_rating : '0.00' %></p>
        </div>
        <div class="bg-white rounded-3xl border border-slate-200 p-5">
            <p class="text-xs font-black uppercase text-slate-400">Reviews</p>
            <p class="text-3xl font-black mt-2"><%= dashboard ? dashboard.total_reviews : 0 %></p>
        </div>
    </section>

    <section class="mb-10">
        <h2 class="text-2xl font-black mb-4">Your Listings</h2>
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            <% if (!registeredHomes || registeredHomes.length === 0) { %>
                <div class="col-span-full bg-white rounded-3xl border border-dashed border-slate-300 p-10 text-center">
                    <h3 class="text-2xl font-black">No homes yet</h3>
                    <p class="text-slate-500 mt-2">Add cities and amenities in MySQL, then create your first home.</p>
                </div>
            <% } %>

            <% registeredHomes.forEach(home => { %>
                <article class="bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm">
                    <div class="relative h-40 bg-gradient-to-br from-rose-100 via-amber-50 to-sky-100 flex items-center justify-center text-center px-6 overflow-hidden">
                        <% if (home.imageUrl) { %>
                            <img src="<%= home.imageUrl %>" alt="<%= home.title %>" class="absolute inset-0 w-full h-full object-cover">
                            <div class="absolute inset-0 bg-slate-950/25"></div>
                        <% } %>
                        <h3 class="relative text-2xl font-black <%= home.imageUrl ? 'text-white drop-shadow' : '' %>"><%= home.title %></h3>
                    </div>
                    <div class="p-6 space-y-4">
                        <p class="font-bold text-slate-500"><%= home.city_name %>, <%= home.country %></p>
                        <p class="text-2xl font-black text-rose-500">PKR <%= home.price_per_night %></p>
                        <% if (home.active_booking_count > 0) { %>
                            <p class="rounded-2xl bg-amber-50 text-amber-700 px-4 py-2 text-sm font-bold">
                                <%= home.active_booking_count %> active booking(s). Delete is locked.
                            </p>
                        <% } %>
                        <div class="grid grid-cols-2 gap-3">
                            <a href="/host/edit-home/<%= home.property_id %>?editing=true" class="text-center bg-slate-900 text-white py-3 rounded-2xl font-bold">Edit</a>
                            <% if (home.active_booking_count > 0) { %>
                                <button type="button" disabled class="w-full border border-slate-200 text-slate-400 py-3 rounded-2xl font-bold cursor-not-allowed">Delete</button>
                            <% } else { %>
                                <form action="/host/delete-home" method="POST">
                                    <input type="hidden" name="id" value="<%= home.property_id %>">
                                    <button class="w-full border border-rose-200 text-rose-600 py-3 rounded-2xl font-bold">Delete</button>
                                </form>
                            <% } %>
                        </div>
                        <form action="/host/availability" method="POST" class="grid grid-cols-[1fr_auto] gap-2">
                            <input type="hidden" name="propertyId" value="<%= home.property_id %>">
                            <input type="date" name="availableDate" required class="rounded-2xl border border-slate-200 px-3 py-2">
                            <select name="isBlocked" class="rounded-2xl border border-slate-200 px-3 py-2">
                                <option value="1">Block</option>
                                <option value="0">Open</option>
                            </select>
                            <button class="col-span-2 bg-rose-50 text-rose-600 py-2 rounded-2xl font-bold">Update Availability</button>
                        </form>
                    </div>
                </article>
            <% }) %>
        </div>
    </section>

    <section class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="bg-white rounded-3xl border border-slate-200 p-6">
            <h2 class="text-2xl font-black mb-4">Revenue Report</h2>
            <div class="space-y-3">
                <% if (!revenueReport || revenueReport.length === 0) { %>
                    <p class="text-slate-500">No revenue yet this year.</p>
                <% } %>
                <% revenueReport.forEach(row => { %>
                    <div class="flex justify-between border-b border-slate-100 pb-3">
                        <span class="font-bold"><%= row.month_name %></span>
                        <span class="font-black">PKR <%= row.gross_revenue %></span>
                    </div>
                <% }) %>
            </div>
        </div>
        <div class="bg-white rounded-3xl border border-slate-200 p-6">
            <h2 class="text-2xl font-black mb-4">Recent Host Bookings</h2>
            <div class="space-y-3">
                <% if (!hostBookings || hostBookings.length === 0) { %>
                    <p class="text-slate-500">No bookings yet.</p>
                <% } %>
                <% hostBookings.slice(0, 6).forEach(book => { %>
                    <div class="border-b border-slate-100 pb-3">
                        <p class="font-black"><%= book.property_title %></p>
                        <p class="text-sm text-slate-500"><%= book.guest_name %> | <%= book.check_in %> to <%= book.check_out %> | <%= book.status %></p>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>
</main>

</body>
</html>
