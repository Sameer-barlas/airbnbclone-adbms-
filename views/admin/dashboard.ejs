<%- include('../partials/head') %>

<body class="min-h-screen bg-gradient-to-br from-slate-100 via-sky-50/70 to-orange-50/60 text-slate-950">
<%- include('../partials/navbar') %>

<main class="relative overflow-hidden">
    <% const maxRevenue = revenueByCity && revenueByCity.length ? Math.max(...revenueByCity.map(row => Number(row.total_revenue || 0)), 1) : 1; %>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,rgba(244,63,94,0.055),transparent_30%),radial-gradient(circle_at_85%_25%,rgba(251,146,60,0.11),transparent_32%),radial-gradient(circle_at_52%_75%,rgba(14,165,233,0.12),transparent_36%)]"></div>
    <div class="pointer-events-none absolute -left-28 top-20 h-96 w-96 rounded-full bg-rose-200/45 blur-3xl animate-float-slow"></div>
    <div class="pointer-events-none absolute right-0 top-80 h-96 w-96 rounded-full bg-sky-200/40 blur-3xl animate-float-slow"></div>
    <div class="pointer-events-none absolute bottom-32 left-1/2 h-80 w-80 rounded-full bg-amber-100/70 blur-3xl"></div>

    <section class="relative mx-auto max-w-7xl px-4 pt-10 sm:px-6">
        <div class="relative overflow-hidden rounded-[2.75rem] border border-white bg-gradient-to-br from-slate-950 via-slate-900 to-rose-950 p-6 text-white shadow-2xl shadow-slate-300/70 sm:p-8 lg:p-10 animate-gradient-x">
            <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-rose-500/25 blur-3xl"></div>
            <div class="absolute bottom-0 left-1/3 h-64 w-64 rounded-full bg-sky-400/15 blur-3xl"></div>
            <div class="relative grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
                <div class="animate-slide-in-left">
                    <span class="inline-flex rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.28em] text-rose-200 backdrop-blur">Admin control center</span>
                    <h1 class="mt-5 max-w-3xl text-5xl font-black tracking-tight sm:text-6xl">System Dashboard</h1>
                    <p class="mt-5 max-w-2xl leading-8 text-white/68">Monitor users, homes, revenue, and recent registrations in a clean analytics workspace.</p>
                </div>
                <div class="animate-slide-in-right grid grid-cols-2 gap-3">
                    <div class="rounded-[1.5rem] border border-white/15 bg-white/10 p-5 backdrop-blur">
                        <p class="text-xs font-black uppercase tracking-widest text-white/50">Users</p>
                        <p class="mt-2 text-4xl font-black"><%= stats.totalUsers %></p>
                    </div>
                    <div class="rounded-[1.5rem] border border-white/15 bg-white/10 p-5 backdrop-blur">
                        <p class="text-xs font-black uppercase tracking-widest text-white/50">Revenue</p>
                        <p class="mt-2 text-2xl font-black">PKR <%= stats.totalRevenue %></p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="relative z-10 mx-auto max-w-7xl px-4 py-10 sm:px-6">
        <% if (message) { %>
            <div class="mb-6 rounded-2xl border border-emerald-100 bg-emerald-50 px-5 py-4 font-semibold text-emerald-700 shadow-sm"><%= message %></div>
        <% } %>

        <section class="reveal-on-scroll mb-10 grid grid-cols-2 gap-4 lg:grid-cols-4">
            <div class="rounded-[1.7rem] border border-white bg-white p-5 shadow-xl shadow-slate-200/60 transition hover:-translate-y-1 hover:shadow-2xl">
                <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-rose-50 font-black text-rose-500">U</div>
                <p class="text-xs font-black uppercase tracking-widest text-slate-400">Users</p>
                <p class="mt-2 text-3xl font-black"><%= stats.totalUsers %></p>
            </div>
            <div class="rounded-[1.7rem] border border-white bg-white p-5 shadow-xl shadow-slate-200/60 transition hover:-translate-y-1 hover:shadow-2xl">
                <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-50 font-black text-sky-600">H</div>
                <p class="text-xs font-black uppercase tracking-widest text-slate-400">Homes</p>
                <p class="mt-2 text-3xl font-black"><%= stats.totalProperties %></p>
            </div>
            <div class="rounded-[1.7rem] border border-white bg-white p-5 shadow-xl shadow-slate-200/60 transition hover:-translate-y-1 hover:shadow-2xl">
                <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-violet-50 font-black text-violet-600">B</div>
                <p class="text-xs font-black uppercase tracking-widest text-slate-400">Bookings</p>
                <p class="mt-2 text-3xl font-black"><%= stats.totalBookings %></p>
            </div>
            <div class="rounded-[1.7rem] border border-white bg-white p-5 shadow-xl shadow-slate-200/60 transition hover:-translate-y-1 hover:shadow-2xl">
                <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-50 font-black text-emerald-600">R</div>
                <p class="text-xs font-black uppercase tracking-widest text-slate-400">Revenue</p>
                <p class="mt-2 text-2xl font-black">PKR <%= stats.totalRevenue %></p>
            </div>
        </section>

        <section class="reveal-on-scroll grid grid-cols-1 gap-8 lg:grid-cols-[1.1fr_0.9fr]">
            <div class="rounded-[2rem] border border-white bg-white/95 p-6 shadow-xl shadow-slate-200/60 backdrop-blur">
                <div class="mb-5 flex items-center justify-between">
                    <div>
                        <p class="text-xs font-black uppercase tracking-widest text-rose-500">Access management</p>
                        <h2 class="text-3xl font-black">Users</h2>
                    </div>
                </div>
                <div class="max-h-[620px] space-y-3 overflow-auto pr-1">
                    <% users.forEach(user => { %>
                        <div class="group flex flex-col gap-4 rounded-[1.5rem] border border-slate-100 bg-slate-50 p-4 transition hover:-translate-y-0.5 hover:border-rose-100 hover:bg-white hover:shadow-lg sm:flex-row sm:items-center sm:justify-between">
                            <div class="min-w-0">
                                <div class="flex items-center gap-3">
                                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-white font-black text-rose-500 shadow-sm">
                                        <%= (user.full_name || 'U').charAt(0).toUpperCase() %>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="truncate font-black"><%= user.full_name %></p>
                                        <p class="mt-1 truncate text-sm font-semibold text-slate-500"><%= user.email %></p>
                                    </div>
                                </div>
                                <div class="mt-3 flex flex-wrap gap-2">
                                    <span class="rounded-full px-3 py-1 text-xs font-black uppercase tracking-widest <%= user.role === 'admin' ? 'bg-violet-50 text-violet-600' : user.role === 'host' ? 'bg-orange-50 text-orange-600' : 'bg-slate-100 text-slate-600' %>"><%= user.role %></span>
                                    <span class="rounded-full px-3 py-1 text-xs font-black uppercase tracking-widest <%= user.is_active ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-600' %>"><%= user.is_active ? 'active' : 'inactive' %></span>
                                </div>
                            </div>
                            <form action="/admin/users/status" method="POST">
                                <input type="hidden" name="userId" value="<%= user.user_id %>">
                                <input type="hidden" name="isActive" value="<%= user.is_active ? 0 : 1 %>">
                                <button class="rounded-2xl px-5 py-3 font-black transition <%= user.is_active ? 'bg-rose-50 text-rose-600 hover:bg-rose-100' : 'bg-emerald-50 text-emerald-600 hover:bg-emerald-100' %>">
                                    <%= user.is_active ? 'Suspend' : 'Activate' %>
                                </button>
                            </form>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="space-y-8">
                <div class="rounded-[2rem] border border-white bg-white/95 p-6 shadow-xl shadow-slate-200/60 backdrop-blur">
                    <p class="text-xs font-black uppercase tracking-widest text-rose-500">Analytics</p>
                    <h2 class="mb-5 text-3xl font-black">Revenue By City</h2>
                    <div class="max-h-72 space-y-3 overflow-auto pr-1">
                        <% if (!revenueByCity || revenueByCity.length === 0) { %><p class="rounded-2xl bg-slate-50 p-5 text-slate-500">No revenue records.</p><% } %>
                        <% revenueByCity.forEach(row => { %>
                            <div class="rounded-2xl border-l-4 border-rose-300 bg-slate-50 px-4 py-3 transition hover:bg-rose-50">
                                <div class="flex justify-between gap-4">
                                    <span class="font-black"><%= row.city_name %></span>
                                    <span class="font-black text-rose-500">PKR <%= row.total_revenue %></span>
                                </div>
                                <p class="mt-1 text-xs font-bold uppercase tracking-widest text-slate-400"><%= row.booking_month %>/<%= row.booking_year %></p>
                                <div class="mt-3 h-2 overflow-hidden rounded-full bg-white">
                                    <div class="h-full rounded-full bg-gradient-to-r from-rose-500 to-orange-400" style="width: <%= Math.max(8, Math.round((Number(row.total_revenue || 0) / maxRevenue) * 100)) %>%"></div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <div class="rounded-[2rem] border border-white bg-white/95 p-6 shadow-xl shadow-slate-200/60 backdrop-blur">
                    <p class="text-xs font-black uppercase tracking-widest text-rose-500">Latest activity</p>
                    <h2 class="mb-5 text-3xl font-black">Recent Registrations</h2>
                    <div class="max-h-72 space-y-3 overflow-auto pr-1">
                        <% if (!auditLog || auditLog.length === 0) { %><p class="rounded-2xl bg-slate-50 p-5 text-slate-500">No recent registrations.</p><% } %>
                        <% auditLog.forEach(log => { %>
                            <div class="rounded-2xl bg-slate-50 px-4 py-3 transition hover:bg-rose-50">
                                <p class="font-black"><%= log.full_name || 'New user' %></p>
                                <p class="mt-1 text-sm font-semibold text-slate-500">User #<%= log.record_id %> registered on <%= log.action_time %></p>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </section>
    </section>
</main>

</body>
</html>
