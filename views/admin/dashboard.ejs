<%- include('../partials/head') %>

<body class="min-h-screen bg-slate-50 text-slate-950">
<%- include('../partials/navbar') %>

<main class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <section class="mb-8 rounded-[2rem] border border-white bg-gradient-to-br from-slate-950 via-slate-900 to-rose-950 p-8 text-white shadow-2xl shadow-slate-200 lg:p-10">
        <p class="text-xs font-black uppercase tracking-[0.3em] text-rose-300">Admin control center</p>
        <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">System Dashboard</h1>
        <p class="mt-3 max-w-2xl text-white/65">Monitor users, homes, revenue, and recent registrations from one premium analytics view.</p>
    </section>

    <% if (message) { %>
        <div class="mb-6 rounded-2xl border border-emerald-100 bg-emerald-50 px-5 py-4 font-semibold text-emerald-700"><%= message %></div>
    <% } %>

    <section class="mb-10 grid grid-cols-2 gap-4 lg:grid-cols-4">
        <div class="rounded-[1.7rem] border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-2xl bg-rose-50 font-black text-rose-500">U</div>
            <p class="text-xs font-black uppercase tracking-widest text-slate-400">Users</p>
            <p class="mt-2 text-3xl font-black"><%= stats.totalUsers %></p>
        </div>
        <div class="rounded-[1.7rem] border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-2xl bg-sky-50 font-black text-sky-600">H</div>
            <p class="text-xs font-black uppercase tracking-widest text-slate-400">Homes</p>
            <p class="mt-2 text-3xl font-black"><%= stats.totalProperties %></p>
        </div>
        <div class="rounded-[1.7rem] border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-2xl bg-violet-50 font-black text-violet-600">B</div>
            <p class="text-xs font-black uppercase tracking-widest text-slate-400">Bookings</p>
            <p class="mt-2 text-3xl font-black"><%= stats.totalBookings %></p>
        </div>
        <div class="rounded-[1.7rem] border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-2xl bg-emerald-50 font-black text-emerald-600">R</div>
            <p class="text-xs font-black uppercase tracking-widest text-slate-400">Revenue</p>
            <p class="mt-2 text-2xl font-black">PKR <%= stats.totalRevenue %></p>
        </div>
    </section>

    <section class="grid grid-cols-1 gap-8 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
            <div class="mb-5 flex items-center justify-between">
                <div>
                    <p class="text-xs font-black uppercase tracking-widest text-rose-500">Access management</p>
                    <h2 class="text-2xl font-black">Users</h2>
                </div>
            </div>
            <div class="max-h-[560px] space-y-3 overflow-auto pr-1">
                <% users.forEach(user => { %>
                    <div class="flex flex-col gap-4 rounded-2xl bg-slate-50 p-4 sm:flex-row sm:items-center sm:justify-between">
                        <div>
                            <p class="font-black"><%= user.full_name %></p>
                            <p class="mt-1 text-sm font-semibold text-slate-500"><%= user.email %></p>
                            <div class="mt-2 flex flex-wrap gap-2">
                                <span class="rounded-full bg-white px-3 py-1 text-xs font-black uppercase tracking-widest text-slate-500"><%= user.role %></span>
                                <span class="rounded-full px-3 py-1 text-xs font-black uppercase tracking-widest <%= user.is_active ? 'bg-emerald-50 text-emerald-600' : 'bg-rose-50 text-rose-600' %>"><%= user.is_active ? 'active' : 'inactive' %></span>
                            </div>
                        </div>
                        <form action="/admin/users/status" method="POST">
                            <input type="hidden" name="userId" value="<%= user.user_id %>">
                            <input type="hidden" name="isActive" value="<%= user.is_active ? 0 : 1 %>">
                            <button class="rounded-2xl px-5 py-3 font-black transition <%= user.is_active ? 'bg-rose-50 text-rose-600 hover:bg-rose-100' : 'bg-emerald-50 text-emerald-600 hover:bg-emerald-100' %>">
                                <%= user.is_active ? 'Suspend' : 'Activate' %>
                            </button>
                        </form>
                    </div>
                <% }) %>
            </div>
        </div>

        <div class="space-y-8">
            <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-xs font-black uppercase tracking-widest text-rose-500">Analytics</p>
                <h2 class="mb-5 text-2xl font-black">Revenue By City</h2>
                <div class="max-h-72 space-y-3 overflow-auto pr-1">
                    <% if (!revenueByCity || revenueByCity.length === 0) { %><p class="rounded-2xl bg-slate-50 p-5 text-slate-500">No revenue records.</p><% } %>
                    <% revenueByCity.forEach(row => { %>
                        <div class="rounded-2xl bg-slate-50 px-4 py-3">
                            <div class="flex justify-between gap-4">
                                <span class="font-black"><%= row.city_name %></span>
                                <span class="font-black text-rose-500">PKR <%= row.total_revenue %></span>
                            </div>
                            <p class="mt-1 text-xs font-bold uppercase tracking-widest text-slate-400"><%= row.booking_month %>/<%= row.booking_year %></p>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-xs font-black uppercase tracking-widest text-rose-500">Latest activity</p>
                <h2 class="mb-5 text-2xl font-black">Recent Registrations</h2>
                <div class="max-h-72 space-y-3 overflow-auto pr-1">
                    <% if (!auditLog || auditLog.length === 0) { %><p class="rounded-2xl bg-slate-50 p-5 text-slate-500">No recent registrations.</p><% } %>
                    <% auditLog.forEach(log => { %>
                        <div class="rounded-2xl bg-slate-50 px-4 py-3">
                            <p class="font-black"><%= log.full_name || 'New user' %></p>
                            <p class="mt-1 text-sm font-semibold text-slate-500">User #<%= log.record_id %> registered on <%= log.action_time %></p>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </section>
</main>

</body>
</html>
