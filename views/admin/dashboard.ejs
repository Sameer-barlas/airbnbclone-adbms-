<%- include('../partials/head') %>

<body class="min-h-screen bg-slate-50 text-slate-900">
<%- include('../partials/navbar') %>

<main class="max-w-7xl mx-auto px-6 py-10">
    <div class="mb-8">
        <p class="text-xs font-black uppercase tracking-[0.3em] text-rose-500">Admin</p>
        <h1 class="text-4xl font-black mt-2">System Dashboard</h1>
    </div>

    <% if (message) { %>
        <div class="mb-6 rounded-2xl border border-emerald-100 bg-emerald-50 px-5 py-4 text-emerald-700 font-semibold"><%= message %></div>
    <% } %>

    <section class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
        <div class="bg-white rounded-3xl border border-slate-200 p-5"><p class="text-xs font-black uppercase text-slate-400">Users</p><p class="text-3xl font-black mt-2"><%= stats.totalUsers %></p></div>
        <div class="bg-white rounded-3xl border border-slate-200 p-5"><p class="text-xs font-black uppercase text-slate-400">Homes</p><p class="text-3xl font-black mt-2"><%= stats.totalProperties %></p></div>
        <div class="bg-white rounded-3xl border border-slate-200 p-5"><p class="text-xs font-black uppercase text-slate-400">Bookings</p><p class="text-3xl font-black mt-2"><%= stats.totalBookings %></p></div>
        <div class="bg-white rounded-3xl border border-slate-200 p-5"><p class="text-xs font-black uppercase text-slate-400">Revenue</p><p class="text-3xl font-black mt-2">PKR <%= stats.totalRevenue %></p></div>
    </section>

    <section class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="bg-white rounded-3xl border border-slate-200 p-6">
            <h2 class="text-2xl font-black mb-4">Users</h2>
            <div class="space-y-3 max-h-[520px] overflow-auto">
                <% users.forEach(user => { %>
                    <div class="flex items-center justify-between gap-4 border-b border-slate-100 pb-3">
                        <div>
                            <p class="font-black"><%= user.full_name %></p>
                            <p class="text-sm text-slate-500"><%= user.email %> | <%= user.role %> | <%= user.is_active ? 'active' : 'inactive' %></p>
                        </div>
                        <form action="/admin/users/status" method="POST">
                            <input type="hidden" name="userId" value="<%= user.user_id %>">
                            <input type="hidden" name="isActive" value="<%= user.is_active ? 0 : 1 %>">
                            <button class="px-4 py-2 rounded-2xl font-bold <%= user.is_active ? 'bg-rose-50 text-rose-600' : 'bg-emerald-50 text-emerald-600' %>">
                                <%= user.is_active ? 'Suspend' : 'Activate' %>
                            </button>
                        </form>
                    </div>
                <% }) %>
            </div>
        </div>

        <div class="space-y-8">
            <div class="bg-white rounded-3xl border border-slate-200 p-6">
                <h2 class="text-2xl font-black mb-4">Revenue By City</h2>
                <div class="space-y-3 max-h-64 overflow-auto">
                    <% if (!revenueByCity || revenueByCity.length === 0) { %><p class="text-slate-500">No revenue records.</p><% } %>
                    <% revenueByCity.forEach(row => { %>
                        <div class="flex justify-between border-b border-slate-100 pb-3">
                            <span class="font-bold"><%= row.city_name %> <%= row.booking_month %>/<%= row.booking_year %></span>
                            <span class="font-black">PKR <%= row.total_revenue %></span>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="bg-white rounded-3xl border border-slate-200 p-6">
                <h2 class="text-2xl font-black mb-4">Recent Registrations</h2>
                <div class="space-y-3 max-h-64 overflow-auto">
                    <% if (!auditLog || auditLog.length === 0) { %><p class="text-slate-500">No recent registrations.</p><% } %>
                    <% auditLog.forEach(log => { %>
                        <div class="border-b border-slate-100 pb-3">
                            <p class="font-black"><%= log.full_name || 'New user' %></p>
                            <p class="text-sm text-slate-500">User #<%= log.record_id %> registered on <%= log.action_time %></p>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </section>
</main>

</body>
</html>
