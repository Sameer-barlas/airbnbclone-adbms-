<%- include('../partials/head') %>

<body class="min-h-screen bg-slate-50 text-slate-900 flex flex-col">
<%- include('../partials/navbar') %>

<main class="flex-grow flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-2xl bg-white border border-slate-200 rounded-3xl shadow-xl p-8">
        <div class="mb-8 text-center">
            <p class="text-xs font-black uppercase tracking-[0.25em] text-rose-500 mb-2">Join StayEase</p>
            <h1 class="text-4xl font-black text-slate-900">Create Account</h1>
            <p class="text-slate-500 mt-2">Travel as a guest or list homes as a host.</p>
        </div>

        <% if (errorMessage) { %>
            <div class="mb-6 rounded-2xl border border-rose-100 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-600">
                <%= errorMessage %>
            </div>
        <% } %>

        <form action="/signup" method="POST" class="space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block mb-1.5 text-xs font-black uppercase tracking-widest text-slate-500">Full Name</label>
                    <input type="text" name="fullName" value="<%= oldInput.fullName %>" required class="w-full border-2 border-slate-100 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                </div>
                <div>
                    <label class="block mb-1.5 text-xs font-black uppercase tracking-widest text-slate-500">Email</label>
                    <input type="email" name="email" value="<%= oldInput.email %>" required class="w-full border-2 border-slate-100 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block mb-1.5 text-xs font-black uppercase tracking-widest text-slate-500">Phone</label>
                    <input type="text" name="phone" value="<%= oldInput.phone %>" placeholder="0300-1234567" class="w-full border-2 border-slate-100 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                </div>
                <div>
                    <label class="block mb-1.5 text-xs font-black uppercase tracking-widest text-slate-500">Date of Birth</label>
                    <input type="date" name="dateOfBirth" value="<%= oldInput.dateOfBirth %>" class="w-full border-2 border-slate-100 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block mb-1.5 text-xs font-black uppercase tracking-widest text-slate-500">Password</label>
                    <input type="password" name="password" minlength="6" required class="w-full border-2 border-slate-100 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                </div>
                <div>
                    <label class="block mb-1.5 text-xs font-black uppercase tracking-widest text-slate-500">Confirm Password</label>
                    <input type="password" name="confirmPassword" minlength="6" required class="w-full border-2 border-slate-100 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                </div>
            </div>

            <div>
                <label class="block mb-2 text-xs font-black uppercase tracking-widest text-slate-500">Account Type</label>
                <div class="grid grid-cols-2 gap-3">
                    <label class="cursor-pointer rounded-2xl border-2 border-slate-100 p-4 has-[:checked]:border-rose-400 has-[:checked]:bg-rose-50">
                        <input type="radio" name="role" value="guest" class="sr-only" <%= oldInput.role !== 'host' ? 'checked' : '' %>>
                        <span class="block font-black text-slate-900">Guest</span>
                        <span class="text-xs text-slate-500">Book, favourite, review</span>
                    </label>
                    <label class="cursor-pointer rounded-2xl border-2 border-slate-100 p-4 has-[:checked]:border-rose-400 has-[:checked]:bg-rose-50">
                        <input type="radio" name="role" value="host" class="sr-only" <%= oldInput.role === 'host' ? 'checked' : '' %>>
                        <span class="block font-black text-slate-900">Host</span>
                        <span class="text-xs text-slate-500">Manage listings</span>
                    </label>
                </div>
            </div>

            <button type="submit" class="w-full bg-slate-900 text-white py-4 rounded-2xl font-bold hover:bg-slate-800 transition">
                Create Account
            </button>
        </form>

        <p class="text-center text-sm text-slate-500 mt-6">
            Already have an account?
            <a href="/login" class="font-bold text-rose-500 hover:text-rose-600">Login</a>
        </p>
    </div>
</main>

</body>
</html>
