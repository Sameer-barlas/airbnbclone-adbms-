<%- include('../partials/head') %>

<body class="min-h-screen bg-gradient-to-br from-slate-100 via-sky-50/70 to-orange-50/60 text-slate-950 flex flex-col">
<%- include('../partials/navbar') %>

<main class="relative flex-grow overflow-hidden px-4 py-10 sm:px-6">
    <div class="pointer-events-none absolute -left-24 top-16 h-80 w-80 rounded-full bg-rose-200/50 blur-3xl animate-float-slow"></div>
    <div class="pointer-events-none absolute right-0 top-40 h-96 w-96 rounded-full bg-cyan-100/60 blur-3xl animate-float-slow"></div>
    <div class="pointer-events-none absolute bottom-10 left-1/2 h-72 w-72 rounded-full bg-orange-200/45 blur-3xl"></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_18%_18%,rgba(244,63,94,0.10),transparent_32%),radial-gradient(circle_at_88%_30%,rgba(251,146,60,0.11),transparent_34%),radial-gradient(circle_at_50%_90%,rgba(14,165,233,0.12),transparent_35%)]"></div>

    <section class="relative mx-auto max-w-3xl">
        <div class="w-full rounded-[2.5rem] border border-slate-300/70 bg-white/80 p-5 shadow-2xl shadow-slate-300/50 backdrop-blur-xl sm:p-8">
            <div class="mb-8 text-center">
                <p class="mb-2 text-xs font-black uppercase tracking-[0.25em] text-rose-500">Join StayEase</p>
                <h1 class="text-4xl font-black text-slate-950 sm:text-5xl">Create Account</h1>
                <p class="mt-2 text-slate-500">Travel as a guest or list homes as a host.</p>
            </div>

            <% if (errorMessage) { %>
                <div class="mb-6 rounded-2xl border border-rose-100 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-600">
                    <%= errorMessage %>
                </div>
            <% } %>

            <form action="/signup" method="POST" class="space-y-5">
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div>
                        <label class="mb-1.5 block text-xs font-black uppercase tracking-widest text-slate-500">Full Name</label>
                        <input type="text" name="fullName" value="<%= oldInput.fullName %>" required class="w-full rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 text-sm font-semibold outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                    </div>
                    <div>
                        <label class="mb-1.5 block text-xs font-black uppercase tracking-widest text-slate-500">Email</label>
                        <input type="email" name="email" value="<%= oldInput.email %>" required class="w-full rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 text-sm font-semibold outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div>
                        <label class="mb-1.5 block text-xs font-black uppercase tracking-widest text-slate-500">Phone</label>
                        <input type="text" name="phone" value="<%= oldInput.phone %>" placeholder="0300-1234567" class="w-full rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 text-sm font-semibold outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                    </div>
                    <div>
                        <label class="mb-1.5 block text-xs font-black uppercase tracking-widest text-slate-500">Date of Birth</label>
                        <input type="date" name="dateOfBirth" value="<%= oldInput.dateOfBirth %>" class="w-full rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 text-sm font-semibold outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div>
                        <label class="mb-1.5 block text-xs font-black uppercase tracking-widest text-slate-500">Password</label>
                        <input type="password" name="password" minlength="6" required class="w-full rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 text-sm font-semibold outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                    </div>
                    <div>
                        <label class="mb-1.5 block text-xs font-black uppercase tracking-widest text-slate-500">Confirm Password</label>
                        <input type="password" name="confirmPassword" minlength="6" required class="w-full rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 text-sm font-semibold outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100">
                    </div>
                </div>

                <div>
                    <label class="mb-2 block text-xs font-black uppercase tracking-widest text-slate-500">Account Type</label>
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                        <label class="cursor-pointer rounded-2xl border border-slate-200 bg-white/80 p-4 transition has-[:checked]:border-rose-400 has-[:checked]:bg-rose-50 hover:border-rose-200 hover:bg-rose-50">
                            <input type="radio" name="role" value="guest" class="sr-only" <%= oldInput.role !== 'host' ? 'checked' : '' %>>
                            <span class="block font-black text-slate-950">Guest</span>
                            <span class="text-xs text-slate-500">Book, favourite, review</span>
                        </label>
                        <label class="cursor-pointer rounded-2xl border border-slate-200 bg-white/80 p-4 transition has-[:checked]:border-rose-400 has-[:checked]:bg-rose-50 hover:border-rose-200 hover:bg-rose-50">
                            <input type="radio" name="role" value="host" class="sr-only" <%= oldInput.role === 'host' ? 'checked' : '' %>>
                            <span class="block font-black text-slate-950">Host</span>
                            <span class="text-xs text-slate-500">Manage listings</span>
                        </label>
                    </div>
                </div>

                <button type="submit" class="w-full rounded-2xl bg-rose-500 py-4 font-black text-white shadow-xl shadow-rose-100 transition hover:-translate-y-1 hover:bg-rose-600">
                    Create Account
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-slate-500">
                Already have an account?
                <a href="/login" class="font-bold text-rose-500 hover:text-rose-600">Login</a>
            </p>
        </div>
    </section>
</main>

</body>
</html>
