<%- include('../partials/head') %>

<body class="min-h-screen bg-gradient-to-br from-slate-100 via-sky-50/70 to-orange-50/60 text-slate-950">
<%- include('../partials/navbar') %>

<main class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,rgba(244,63,94,0.055),transparent_30%),radial-gradient(circle_at_85%_25%,rgba(251,146,60,0.11),transparent_32%),radial-gradient(circle_at_52%_75%,rgba(14,165,233,0.12),transparent_36%)]"></div>
    <div class="pointer-events-none absolute -left-28 top-20 h-96 w-96 rounded-full bg-rose-200/45 blur-3xl animate-float-slow"></div>
    <div class="pointer-events-none absolute right-0 top-80 h-96 w-96 rounded-full bg-sky-200/40 blur-3xl animate-float-slow"></div>

    <section class="relative mx-auto max-w-7xl px-4 pt-10 sm:px-6">
        <div class="relative overflow-hidden rounded-[2.75rem] border border-white bg-gradient-to-br from-slate-950 via-slate-900 to-rose-950 p-6 text-white shadow-2xl shadow-slate-300/70 sm:p-8 lg:p-10 animate-gradient-x">
            <div class="absolute -right-20 -top-20 h-72 w-72 rounded-full bg-rose-500/25 blur-3xl"></div>
            <div class="relative flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
                <div class="animate-slide-in-left">
                    <span class="inline-flex rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.28em] text-rose-200 backdrop-blur">Saved stays</span>
                    <h1 class="mt-5 text-5xl font-black tracking-tight sm:text-6xl">Your Favourites</h1>
                    <p class="mt-4 max-w-2xl leading-8 text-white/68">Keep the homes you love close, then return whenever you are ready to book.</p>
                </div>
                <div class="animate-slide-in-right rounded-[1.75rem] border border-white/15 bg-white/10 px-6 py-5 backdrop-blur">
                    <p class="text-xs font-black uppercase tracking-widest text-white/50">Saved homes</p>
                    <p class="mt-2 text-4xl font-black"><%= favHomes ? favHomes.length : 0 %></p>
                </div>
            </div>
        </div>
    </section>

    <section class="relative z-10 mx-auto max-w-7xl px-4 py-10 sm:px-6">
        <div class="reveal-on-scroll grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            <% if (!favHomes || favHomes.length === 0) { %>
                <div class="col-span-full overflow-hidden rounded-[2rem] border border-dashed border-slate-300 bg-white p-12 text-center shadow-xl shadow-slate-200/60">
                    <h2 class="text-2xl font-black">No favourite homes yet</h2>
                    <p class="mt-2 text-slate-500">Browse listings and save the places you like.</p>
                    <a href="/" class="mt-6 inline-block rounded-2xl bg-slate-950 px-8 py-3 font-bold text-white transition hover:-translate-y-0.5 hover:bg-slate-800">Start Exploring</a>
                </div>
            <% } %>

            <% favHomes.forEach(home => { %>
                <article class="group overflow-hidden rounded-[2.25rem] border border-white bg-white shadow-xl shadow-slate-200/70 transition duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-rose-100/70">
                    <div class="relative h-60 overflow-hidden bg-gradient-to-br from-rose-100 via-amber-50 to-sky-100">
                        <% if (home.imageUrl) { %>
                            <img src="<%= home.imageUrl %>" alt="<%= home.title %>" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-110">
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/65 via-slate-950/10 to-transparent"></div>
                        <% } else { %>
                            <div class="absolute inset-0 premium-shimmer opacity-60"></div>
                        <% } %>
                        <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-rose-500 shadow-sm">Favourite</span>
                        <h2 class="absolute inset-x-5 bottom-5 text-2xl font-black <%= home.imageUrl ? 'text-white drop-shadow' : 'text-slate-950' %>"><%= home.title %></h2>
                    </div>
                    <div class="space-y-4 p-6">
                        <p class="font-bold text-slate-500"><%= home.city_name %>, <%= home.country %></p>
                        <p class="text-2xl font-black text-rose-500">PKR <%= home.price_per_night %> <span class="text-sm font-medium text-slate-400">/ night</span></p>
                        <div class="grid grid-cols-2 gap-3">
                            <a href="/homedetails/<%= home.property_id %>" class="rounded-2xl border border-slate-200 py-3 text-center font-bold transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600">Details</a>
                            <a href="/book/<%= home.property_id %>" class="rounded-2xl bg-rose-500 py-3 text-center font-bold text-white shadow-lg shadow-rose-100 transition hover:-translate-y-0.5 hover:bg-rose-600">Book</a>
                        </div>
                        <form action="/removefromfavourites" method="POST">
                            <input type="hidden" name="propertyId" value="<%= home.property_id %>">
                            <button class="w-full rounded-2xl bg-slate-50 py-3 text-xs font-black uppercase tracking-widest text-slate-400 transition hover:bg-rose-50 hover:text-rose-500">Remove from Favourites</button>
                        </form>
                    </div>
                </article>
            <% }) %>
        </div>
    </section>
</main>

</body>
</html>
