<%- include('../partials/head') %>

<body class="min-h-screen bg-gradient-to-br from-slate-100 via-sky-50/70 to-orange-50/60 text-slate-950">
<%- include('../partials/navbar') %>

<main class="relative overflow-hidden">
    <% const searchCities = Array.isArray(cities) ? cities : []; %>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,rgba(244,63,94,0.055),transparent_30%),radial-gradient(circle_at_85%_25%,rgba(251,146,60,0.11),transparent_32%),radial-gradient(circle_at_52%_75%,rgba(14,165,233,0.12),transparent_36%)]"></div>
    <div class="pointer-events-none absolute -left-32 top-20 h-96 w-96 rounded-full bg-rose-200/45 blur-3xl animate-float-slow"></div>
    <div class="pointer-events-none absolute right-0 top-80 h-96 w-96 rounded-full bg-sky-200/40 blur-3xl animate-float-slow"></div>
    <div class="pointer-events-none absolute bottom-24 left-1/2 h-80 w-80 rounded-full bg-amber-100/70 blur-3xl"></div>

    <section class="relative mx-auto max-w-6xl px-5 pt-8 sm:px-6 lg:pt-10">
        <div class="relative overflow-hidden rounded-[2.5rem] border border-white bg-gradient-to-br from-slate-950 via-slate-900 to-rose-950 p-6 text-white shadow-2xl shadow-slate-300/70 sm:p-7 lg:p-8 animate-gradient-x">
            <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-rose-500/25 blur-3xl"></div>
            <div class="absolute bottom-0 left-1/3 h-64 w-64 rounded-full bg-sky-400/15 blur-3xl"></div>
            <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-slate-950/40 to-transparent"></div>

            <div class="relative grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
                <div class="animate-slide-in-left">
                    <span class="inline-flex rounded-full border border-white/15 bg-white/10 px-4 py-2 text-xs font-black uppercase tracking-[0.28em] text-rose-200 backdrop-blur">
                        StayEase Homes
                    </span>
                    <h1 class="mt-5 max-w-3xl text-4xl font-black tracking-tight sm:text-5xl lg:text-6xl">
                        Find a stay that feels premium before you even arrive.
                    </h1>
                    <p class="mt-5 max-w-2xl text-base leading-8 text-white/68">
                        Browse active homes, compare prices, check amenities, and reserve your next stay with a clean Airbnb-style experience.
                    </p>

                    <div class="mt-8 flex flex-wrap gap-3">
                        <a href="#homes" class="rounded-full bg-rose-500 px-6 py-3 text-sm font-black text-white shadow-xl shadow-rose-950/40 transition hover:-translate-y-1 hover:bg-rose-600">
                            Explore Homes
                        </a>
                        <% if (isGuest) { %>
                            <a href="/favourites" class="rounded-full border border-white/20 bg-white/10 px-6 py-3 text-sm font-black text-white backdrop-blur transition hover:-translate-y-1 hover:bg-white hover:text-slate-950">
                                My Favourites
                            </a>
                        <% } %>
                    </div>
                </div>

                <div class="animate-slide-in-right">
                    <div class="rounded-[2.25rem] border border-white/15 bg-white/10 p-4 shadow-2xl shadow-slate-950/30 backdrop-blur">
                        <div class="relative overflow-hidden rounded-[1.75rem] bg-gradient-to-br from-rose-100 via-white to-sky-100 p-5 text-slate-950">
                            <div class="absolute right-4 top-4 h-16 w-16 rounded-full bg-rose-200/70 blur-2xl"></div>
                            <p class="text-xs font-black uppercase tracking-[0.25em] text-rose-500">Live collection</p>
                            <p class="mt-4 text-5xl font-black"><%= registeredHomes ? registeredHomes.length : 0 %></p>
                            <p class="mt-1 text-sm font-bold text-slate-500">available homes</p>
                            <div class="mt-6 grid grid-cols-3 gap-3">
                                <div class="rounded-2xl bg-white/80 p-3 text-center shadow-sm">
                                    <p class="text-xl font-black"><%= searchCities.length %></p>
                                    <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Cities</p>
                                </div>
                                <div class="rounded-2xl bg-white/80 p-3 text-center shadow-sm">
                                    <p class="text-xl font-black">24/7</p>
                                    <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Access</p>
                                </div>
                                <div class="rounded-2xl bg-white/80 p-3 text-center shadow-sm">
                                    <p class="text-xl font-black">DB</p>
                                    <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Live</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="relative z-10 mx-auto max-w-6xl px-5 py-8 sm:px-6">
        <form action="/search" method="GET" class="reveal-on-scroll rounded-[2rem] border border-white bg-white/90 p-4 shadow-2xl shadow-slate-200/70 backdrop-blur">
            <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-8">
                <div class="xl:col-span-2">
                    <label class="mb-1 block text-[10px] font-black uppercase tracking-widest text-slate-400">City</label>
                    <select name="city" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-800 outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
                        <option value=""><%= searchCities.length ? 'Choose city' : 'No cities available' %></option>
                        <% searchCities.forEach(city => { %>
                            <option value="<%= city.city_name %>" <%= searchInput.city === city.city_name ? 'selected' : '' %>>
                                <%= city.city_name %>, <%= city.country %>
                            </option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label class="mb-1 block text-[10px] font-black uppercase tracking-widest text-slate-400">Check In</label>
                    <input type="date" name="checkIn" value="<%= searchInput.checkIn %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
                </div>
                <div>
                    <label class="mb-1 block text-[10px] font-black uppercase tracking-widest text-slate-400">Check Out</label>
                    <input type="date" name="checkOut" value="<%= searchInput.checkOut %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
                </div>
                <div>
                    <label class="mb-1 block text-[10px] font-black uppercase tracking-widest text-slate-400">Guests</label>
                    <input type="number" min="1" name="guests" value="<%= searchInput.guests || 1 %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
                </div>
                <div>
                    <label class="mb-1 block text-[10px] font-black uppercase tracking-widest text-slate-400">Min Price</label>
                    <input type="number" min="0" name="minPrice" value="<%= searchInput.minPrice %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
                </div>
                <div>
                    <label class="mb-1 block text-[10px] font-black uppercase tracking-widest text-slate-400">Max Price</label>
                    <input type="number" min="0" name="maxPrice" value="<%= searchInput.maxPrice %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
                </div>
                <div class="flex items-end">
                    <button class="w-full rounded-2xl bg-rose-500 px-5 py-3 font-black text-white shadow-lg shadow-rose-100 transition hover:-translate-y-0.5 hover:bg-rose-600">
                        Search
                    </button>
                </div>
            </div>
        </form>
    </section>

    <section id="homes" class="relative z-10 mx-auto mb-12 max-w-6xl rounded-[2.5rem] border border-slate-300/80 bg-white/45 px-5 py-8 shadow-2xl shadow-slate-300/50 backdrop-blur-xl sm:px-6">
        <% if (errorMessage) { %>
            <div class="mb-8 rounded-2xl border border-rose-100 bg-rose-50 px-5 py-4 font-semibold text-rose-700"><%= errorMessage %></div>
        <% } %>

        <div class="mb-6 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.28em] text-rose-500">Curated stays</p>
                <h2 class="mt-2 text-3xl font-black tracking-tight">Homes</h2>
            </div>
            <p class="max-w-md text-sm font-semibold leading-6 text-slate-500">Every card uses your live property data, uploaded images, ratings, amenities, and booking rules.</p>
        </div>

        <div class="reveal-on-scroll grid gap-6 sm:grid-cols-1 md:grid-cols-2 xl:grid-cols-3">
            <% if (!registeredHomes || registeredHomes.length === 0) { %>
                <div class="col-span-full overflow-hidden rounded-[2rem] border border-dashed border-slate-300 bg-white p-12 text-center shadow-xl shadow-slate-200/60">
                    <h2 class="text-2xl font-black">No homes available</h2>
                    <p class="mt-2 text-slate-500">Add homes in your database, or change the search filters.</p>
                </div>
            <% } %>

            <% registeredHomes.forEach(home => { %>
                <article class="group flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-slate-300/80 bg-white/95 shadow-lg shadow-slate-300/50 transition duration-500 hover:-translate-y-2 hover:border-slate-400 hover:shadow-2xl hover:shadow-slate-300/70">
                    <div class="relative h-52 overflow-hidden border-b border-slate-200 bg-gradient-to-br from-rose-50 via-amber-50 to-sky-100">
                        <% if (home.imageUrl) { %>
                            <img src="<%= home.imageUrl %>" alt="<%= home.title %>" class="h-full w-full object-cover transition duration-700 group-hover:scale-110">
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/65 via-slate-950/10 to-transparent"></div>
                        <% } else { %>
                            <div class="absolute inset-0 premium-shimmer opacity-60"></div>
                            <div class="flex h-full items-center justify-center px-8 text-center">
                                <h2 class="relative text-2xl font-black text-slate-950"><%= home.title %></h2>
                            </div>
                        <% } %>
                        <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-rose-500 shadow-sm backdrop-blur"><%= home.property_type %></span>
                        <span class="absolute right-4 top-4 rounded-full bg-slate-950/90 px-3 py-1.5 text-xs font-black text-white shadow-sm"><%= home.avg_rating || '0.00' %> rating</span>
                        <% if (home.imageUrl) { %>
                            <div class="absolute bottom-4 left-4 right-4">
                                <h3 class="line-clamp-1 text-2xl font-black text-white drop-shadow"><%= home.title %></h3>
                                <p class="mt-1 text-sm font-bold text-white/80"><%= home.city_name %>, <%= home.country %></p>
                            </div>
                        <% } %>
                    </div>

                    <div class="flex flex-grow flex-col gap-3 p-5">
                        <% if (!home.imageUrl) { %>
                            <div>
                                <h3 class="line-clamp-1 text-xl font-black"><%= home.title %></h3>
                                <p class="mt-1 text-sm font-bold text-slate-500"><%= home.city_name %>, <%= home.country %></p>
                            </div>
                        <% } %>

                        <div class="flex items-end justify-between gap-3">
                            <p class="text-xl font-black text-slate-950">PKR <%= home.price_per_night %> <span class="text-sm font-medium text-slate-400">/ night</span></p>
                            <span class="rounded-full bg-rose-50 px-3 py-1 text-xs font-black text-rose-500"><%= home.total_reviews %> reviews</span>
                        </div>

                        <div class="flex flex-wrap gap-2 text-xs">
                            <span class="rounded-full bg-slate-100 px-3 py-1 font-bold text-slate-600"><%= home.max_guests %> guests</span>
                            <% if (home.total_rooms) { %>
                                <span class="rounded-full bg-slate-100 px-3 py-1 font-bold text-slate-600"><%= home.total_rooms %> rooms</span>
                            <% } %>
                        </div>

                        <% if (home.amenities) { %>
                            <p class="line-clamp-2 text-sm leading-6 text-slate-500"><%= home.amenities %></p>
                        <% } %>

                        <div class="mt-auto space-y-2 pt-1">
                            <a href="/homedetails/<%= home.property_id %>" class="block rounded-2xl border border-slate-200 py-2.5 text-center text-sm font-black text-slate-700 transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600">
                                View Details
                            </a>

                            <% if (isGuest) { %>
                                <div class="grid grid-cols-2 gap-3">
                                    <a href="/book/<%= home.property_id %>" class="rounded-2xl bg-rose-500 py-2.5 text-center text-sm font-black text-white shadow-lg shadow-rose-100 transition hover:-translate-y-0.5 hover:bg-rose-600">Book</a>
                                    <form action="/addtofavourites" method="POST">
                                        <input type="hidden" name="propertyId" value="<%= home.property_id %>">
                                        <button class="w-full rounded-2xl bg-slate-950 py-2.5 text-sm font-black text-white transition hover:-translate-y-0.5 hover:bg-slate-800">Add to Favourites</button>
                                    </form>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </article>
            <% }) %>
        </div>
    </section>
</main>

</body>
</html>
