<%- include('../partials/head') %>

<body class="min-h-screen bg-slate-50 text-slate-950">
<%- include('../partials/navbar') %>

<main class="mx-auto max-w-7xl px-4 py-10 sm:px-6">
    <section class="mb-8 overflow-hidden rounded-[2rem] border border-white bg-gradient-to-br from-rose-50 via-white to-sky-50 p-6 shadow-sm sm:p-8 lg:p-10">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.3em] text-rose-500">StayEase Homes</p>
                <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">Homes</h1>
                <p class="mt-3 max-w-2xl text-slate-600">Search premium homes by city, dates, guests, and budget. Every result is powered by your existing database flow.</p>
            </div>
            <div class="rounded-3xl bg-white/80 px-5 py-4 shadow-sm">
                <p class="text-xs font-black uppercase tracking-widest text-slate-400">Available homes</p>
                <p class="text-3xl font-black text-slate-950"><%= registeredHomes ? registeredHomes.length : 0 %></p>
            </div>
        </div>
    </section>

    <form action="/search" method="GET" class="mb-10 rounded-[2rem] border border-slate-200 bg-white p-4 shadow-xl shadow-slate-200/60">
        <div class="grid grid-cols-1 gap-3 md:grid-cols-6">
            <div class="md:col-span-2">
                <label class="mb-1 block text-[10px] font-black uppercase tracking-widest text-slate-400">City</label>
                <select name="city" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold text-slate-800 outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
                    <option value="">Choose city</option>
                    <% cities.forEach(city => { %>
                        <option value="<%= city.city_name %>" <%= searchInput.city === city.city_name ? 'selected' : '' %>>
                            <%= city.city_name %>, <%= city.country %>
                        </option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="mb-1 block text-[10px] font-black uppercase tracking-widest text-slate-400">Check In</label>
                <input type="date" name="checkIn" value="<%= searchInput.checkIn %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
            </div>
            <div>
                <label class="mb-1 block text-[10px] font-black uppercase tracking-widest text-slate-400">Check Out</label>
                <input type="date" name="checkOut" value="<%= searchInput.checkOut %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
            </div>
            <div>
                <label class="mb-1 block text-[10px] font-black uppercase tracking-widest text-slate-400">Guests</label>
                <input type="number" min="1" name="guests" value="<%= searchInput.guests || 1 %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
            </div>
            <div class="flex items-end">
                <button class="w-full rounded-2xl bg-rose-500 px-5 py-3 font-black text-white shadow-lg shadow-rose-100 transition hover:-translate-y-0.5 hover:bg-rose-600">
                    Search
                </button>
            </div>
            <div>
                <label class="mb-1 block text-[10px] font-black uppercase tracking-widest text-slate-400">Min Price</label>
                <input type="number" min="0" name="minPrice" value="<%= searchInput.minPrice %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
            </div>
            <div>
                <label class="mb-1 block text-[10px] font-black uppercase tracking-widest text-slate-400">Max Price</label>
                <input type="number" min="0" name="maxPrice" value="<%= searchInput.maxPrice %>" class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 font-semibold outline-none transition focus:border-rose-300 focus:bg-white focus:ring-4 focus:ring-rose-100">
            </div>
        </div>
    </form>

    <% if (errorMessage) { %>
        <div class="mb-8 rounded-2xl border border-rose-100 bg-rose-50 px-5 py-4 font-semibold text-rose-700"><%= errorMessage %></div>
    <% } %>

    <div class="grid gap-8 sm:grid-cols-1 md:grid-cols-2 xl:grid-cols-3">
        <% if (!registeredHomes || registeredHomes.length === 0) { %>
            <div class="col-span-full rounded-[2rem] border border-dashed border-slate-300 bg-white p-12 text-center">
                <h2 class="text-2xl font-black">No homes available</h2>
                <p class="mt-2 text-slate-500">Add homes in your database, or change the search filters.</p>
            </div>
        <% } %>

        <% registeredHomes.forEach(home => { %>
            <article class="group flex h-full flex-col overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-slate-200">
                <div class="relative h-64 overflow-hidden bg-gradient-to-br from-rose-100 via-amber-50 to-sky-100">
                    <% if (home.imageUrl) { %>
                        <img src="<%= home.imageUrl %>" alt="<%= home.title %>" class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/45 to-transparent"></div>
                    <% } else { %>
                        <div class="flex h-full items-center justify-center px-8 text-center">
                            <h2 class="text-3xl font-black text-slate-950"><%= home.title %></h2>
                        </div>
                    <% } %>
                    <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-rose-500 shadow-sm"><%= home.property_type %></span>
                    <span class="absolute right-4 top-4 rounded-full bg-slate-950/90 px-3 py-1.5 text-xs font-black text-white"><%= home.avg_rating || '0.00' %> rating</span>
                </div>

                <div class="flex flex-grow flex-col gap-4 p-6">
                    <div>
                        <h3 class="line-clamp-1 text-2xl font-black"><%= home.title %></h3>
                        <p class="mt-1 text-sm font-bold text-slate-500"><%= home.city_name %>, <%= home.country %></p>
                    </div>

                    <p class="text-2xl font-black text-slate-950">PKR <%= home.price_per_night %> <span class="text-sm font-medium text-slate-400">/ night</span></p>

                    <div class="flex flex-wrap gap-2 text-xs">
                        <span class="rounded-full bg-slate-100 px-3 py-1 font-bold text-slate-600"><%= home.max_guests %> guests</span>
                        <span class="rounded-full bg-slate-100 px-3 py-1 font-bold text-slate-600"><%= home.total_reviews %> reviews</span>
                    </div>

                    <% if (home.amenities) { %>
                        <p class="line-clamp-2 text-sm leading-6 text-slate-500"><%= home.amenities %></p>
                    <% } %>

                    <div class="mt-auto space-y-3 pt-2">
                        <a href="/homedetails/<%= home.property_id %>" class="block rounded-2xl border border-slate-200 py-3 text-center text-sm font-black text-slate-700 transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600">
                            View Details
                        </a>

                        <% if (isGuest) { %>
                            <div class="grid grid-cols-2 gap-3">
                                <a href="/book/<%= home.property_id %>" class="rounded-2xl bg-rose-500 py-3 text-center text-sm font-black text-white shadow-lg shadow-rose-100 transition hover:bg-rose-600">Book</a>
                                <form action="/addtofavourites" method="POST">
                                    <input type="hidden" name="propertyId" value="<%= home.property_id %>">
                                    <button class="w-full rounded-2xl bg-slate-950 py-3 text-sm font-black text-white transition hover:bg-slate-800">Add to Favourites</button>
                                </form>
                            </div>
                        <% } %>
                    </div>
                </div>
            </article>
        <% }) %>
    </div>
</main>

</body>
</html>
