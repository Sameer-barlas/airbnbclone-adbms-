<%- include('../partials/head') %>

<body class="bg-slate-50 min-h-screen text-slate-900">
<%- include('../partials/navbar') %>

<main class="max-w-7xl mx-auto px-6 py-10">
    <section class="mb-8">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.3em] text-rose-500 mb-2">StayEase Homes</p>
                <h1 class="text-4xl md:text-5xl font-black tracking-tight">Homes</h1>
                <p class="text-slate-600 mt-3 max-w-2xl">Search active homes by city, travel dates, guest count, and price.</p>
            </div>
        </div>
    </section>

    <form action="/search" method="GET" class="bg-white rounded-3xl border border-slate-200 shadow-sm p-5 mb-10 grid grid-cols-1 md:grid-cols-6 gap-4">
        <div class="md:col-span-2">
            <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">City</label>
            <select name="city" class="w-full rounded-2xl border border-slate-200 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-rose-100">
                <option value="">Choose city</option>
                <% cities.forEach(city => { %>
                    <option value="<%= city.city_name %>" <%= searchInput.city === city.city_name ? 'selected' : '' %>>
                        <%= city.city_name %>, <%= city.country %>
                    </option>
                <% }) %>
            </select>
        </div>
        <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Check In</label>
            <input type="date" name="checkIn" value="<%= searchInput.checkIn %>" class="w-full rounded-2xl border border-slate-200 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-rose-100">
        </div>
        <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Check Out</label>
            <input type="date" name="checkOut" value="<%= searchInput.checkOut %>" class="w-full rounded-2xl border border-slate-200 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-rose-100">
        </div>
        <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Guests</label>
            <input type="number" min="1" name="guests" value="<%= searchInput.guests || 1 %>" class="w-full rounded-2xl border border-slate-200 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-rose-100">
        </div>
        <div class="flex items-end">
            <button class="w-full bg-rose-500 text-white rounded-2xl px-5 py-3 font-black hover:bg-rose-600 transition">Search</button>
        </div>
        <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Min Price</label>
            <input type="number" min="0" name="minPrice" value="<%= searchInput.minPrice %>" class="w-full rounded-2xl border border-slate-200 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-rose-100">
        </div>
        <div>
            <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1">Max Price</label>
            <input type="number" min="0" name="maxPrice" value="<%= searchInput.maxPrice %>" class="w-full rounded-2xl border border-slate-200 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-rose-100">
        </div>
    </form>

    <% if (errorMessage) { %>
        <div class="mb-8 rounded-2xl border border-rose-100 bg-rose-50 px-5 py-4 text-rose-700 font-semibold"><%= errorMessage %></div>
    <% } %>

    <div class="grid gap-8 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        <% if (!registeredHomes || registeredHomes.length === 0) { %>
            <div class="col-span-full bg-white border border-dashed border-slate-300 rounded-3xl p-12 text-center">
                <h2 class="text-2xl font-black">No homes available</h2>
                <p class="text-slate-500 mt-2">Add homes in your database, or change the search filters.</p>
            </div>
        <% } %>

        <% registeredHomes.forEach(home => { %>
            <article class="bg-white rounded-3xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition duration-300 flex flex-col h-full">
                <div class="relative h-52 bg-gradient-to-br from-rose-100 via-amber-50 to-sky-100 flex items-center justify-center overflow-hidden">
                    <% if (home.imageUrl) { %>
                        <img src="<%= home.imageUrl %>" alt="<%= home.title %>" class="absolute inset-0 w-full h-full object-cover">
                        <div class="absolute inset-0 bg-slate-950/20"></div>
                    <% } %>
                    <div class="text-center px-6">
                        <p class="relative text-[10px] font-black uppercase tracking-[0.3em] <%= home.imageUrl ? 'text-white' : 'text-rose-500' %>"><%= home.property_type %></p>
                        <h2 class="relative text-2xl font-black <%= home.imageUrl ? 'text-white drop-shadow' : 'text-slate-900' %> mt-2"><%= home.title %></h2>
                    </div>
                    <div class="absolute top-4 right-4 bg-white/90 px-3 py-1.5 rounded-full text-xs font-black text-amber-600 shadow-sm">
                        <%= home.avg_rating || '0.00' %> rating
                    </div>
                </div>

                <div class="p-6 flex flex-col flex-grow gap-4">
                    <div>
                        <p class="text-slate-500 text-sm font-semibold"><%= home.city_name %>, <%= home.country %></p>
                        <p class="text-slate-900 font-black text-xl mt-1">PKR <%= home.price_per_night %> <span class="text-sm font-medium text-slate-500">/ night</span></p>
                    </div>

                    <div class="flex flex-wrap gap-2 text-xs">
                        <span class="px-3 py-1 rounded-full bg-slate-100 font-bold text-slate-600"><%= home.max_guests %> guests</span>
                        <span class="px-3 py-1 rounded-full bg-slate-100 font-bold text-slate-600"><%= home.total_reviews %> reviews</span>
                    </div>

                    <% if (home.amenities) { %>
                        <p class="text-sm text-slate-500 line-clamp-2"><%= home.amenities %></p>
                    <% } %>

                    <div class="pt-2 mt-auto space-y-3">
                        <a href="/homedetails/<%= home.property_id %>" class="block text-center border border-slate-200 text-slate-700 py-3 rounded-2xl text-sm font-bold hover:bg-slate-50 transition">
                            View Details
                        </a>

                        <% if (isGuest) { %>
                            <div class="grid grid-cols-2 gap-3">
                                <a href="/book/<%= home.property_id %>" class="text-center bg-rose-500 text-white py-3 rounded-2xl text-sm font-bold hover:bg-rose-600 transition">Book</a>
                                <form action="/addtofavourites" method="POST">
                                    <input type="hidden" name="propertyId" value="<%= home.property_id %>">
                                    <button class="w-full bg-slate-900 text-white py-3 rounded-2xl text-sm font-bold hover:bg-slate-800 transition">Add to Favourites</button>
                                </form>
                            </div>
                        <% } %>
                    </div>
                </div>
            </article>
        <% }) %>
    </div>
</main>

</body>
</html>
