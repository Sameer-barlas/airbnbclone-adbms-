<%- include('../partials/head') %>

<body class="min-h-screen bg-gradient-to-br from-slate-100 via-sky-50/70 to-orange-50/60 text-slate-950">
<%- include('../partials/navbar') %>

<main class="overflow-hidden">
    <% const safeHomes = registeredHomes || []; %>
    <% const cityNames = [...new Set(safeHomes.map(home => `${home.city_name}, ${home.country}`).filter(Boolean))]; %>
    <% const popularCities = ['Lahore', 'Karachi', 'Islamabad', 'Dubai', 'Istanbul']; %>
    <% const reviewCount = safeHomes.reduce((sum, home) => sum + Number(home.total_reviews || 0), 0); %>
    <% const guestCapacity = safeHomes.reduce((sum, home) => sum + Number(home.max_guests || 0), 0); %>
    <% const heroHome = safeHomes[0]; %>
    <% const secondHome = safeHomes[1] || safeHomes[0]; %>

    <section class="relative min-h-[calc(100vh-88px)] overflow-hidden bg-gradient-to-br from-rose-50 via-white to-sky-50 animate-gradient-x">
        <div class="absolute -left-24 top-24 h-72 w-72 rounded-full bg-rose-300/30 blur-3xl animate-float-slow"></div>
        <div class="absolute right-0 top-16 h-80 w-80 rounded-full bg-orange-200/40 blur-3xl animate-float-slow"></div>
        <div class="absolute bottom-8 left-1/2 h-80 w-80 rounded-full bg-sky-200/50 blur-3xl animate-float-slow"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(244,63,94,0.08),transparent_34%),radial-gradient(circle_at_80%_10%,rgba(251,146,60,0.10),transparent_30%),radial-gradient(circle_at_55%_85%,rgba(125,211,252,0.16),transparent_34%)]"></div>

        <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[1fr_0.95fr] lg:py-20">
            <div class="animate-slide-in-left">
                <div class="inline-flex items-center gap-2 rounded-full border border-white bg-white/70 px-4 py-2 text-xs font-black uppercase tracking-[0.28em] text-rose-500 shadow-sm backdrop-blur">
                    <span class="h-2 w-2 rounded-full bg-rose-500"></span>
                    Verified hosts
                </div>
                <h1 class="mt-7 max-w-4xl text-5xl font-black leading-[0.92] tracking-tight text-slate-950 sm:text-6xl lg:text-7xl">
                    Find stays that feel like home.
                </h1>
                <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">
                    StayEase brings premium homes, trusted hosts, clean availability, and a smooth booking journey into one modern travel platform.
                </p>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <a href="#featured" class="animate-pulse-soft inline-flex justify-center rounded-2xl bg-rose-500 px-7 py-4 font-black text-white shadow-xl shadow-rose-200 transition hover:-translate-y-1 hover:bg-rose-600">
                        Explore Homes
                    </a>
                    <a href="/signup" class="inline-flex justify-center rounded-2xl border border-slate-200 bg-white/90 px-7 py-4 font-black text-slate-950 shadow-sm backdrop-blur transition hover:-translate-y-1 hover:border-rose-200 hover:text-rose-600">
                        Become a Host
                    </a>
                </div>

                <div class="mt-8 rounded-[2rem] border border-white bg-white/85 p-3 shadow-2xl shadow-slate-200/70 backdrop-blur">
                    <div class="grid grid-cols-1 gap-3 md:grid-cols-[1.2fr_1fr_1fr_0.8fr_auto]">
                        <div class="rounded-2xl bg-slate-50 px-4 py-3">
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">City</p>
                            <p class="mt-1 font-black text-slate-800"><%= cityNames[0] || 'Choose destination' %></p>
                        </div>
                        <div class="rounded-2xl bg-slate-50 px-4 py-3">
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Check in</p>
                            <p class="mt-1 font-black text-slate-800">Select date</p>
                        </div>
                        <div class="rounded-2xl bg-slate-50 px-4 py-3">
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Check out</p>
                            <p class="mt-1 font-black text-slate-800">Select date</p>
                        </div>
                        <div class="rounded-2xl bg-slate-50 px-4 py-3">
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Guests</p>
                            <p class="mt-1 font-black text-slate-800">2 guests</p>
                        </div>
                        <a href="/signup" class="inline-flex items-center justify-center rounded-2xl bg-slate-950 px-6 py-4 font-black text-white transition hover:-translate-y-0.5 hover:bg-rose-500">
                            Search
                        </a>
                    </div>
                </div>

                <div class="mt-8 flex flex-wrap gap-3">
                    <% ['Verified hosts', 'Secure bookings', 'Premium stays'].forEach(badge => { %>
                        <span class="relative overflow-hidden rounded-full border border-white bg-white/75 px-4 py-2 text-xs font-black uppercase tracking-widest text-slate-600 shadow-sm backdrop-blur transition hover:-translate-y-0.5 hover:text-rose-600">
                            <span class="premium-shimmer absolute inset-0 opacity-40"></span>
                            <span class="relative"><%= badge %></span>
                        </span>
                    <% }) %>
                </div>
            </div>

            <div class="relative min-h-[620px] animate-slide-in-right">
                <div class="absolute left-2 top-6 z-20 w-60 rounded-[2rem] border border-white bg-white/85 p-4 shadow-2xl shadow-slate-300/60 backdrop-blur animate-float-slow">
                    <p class="text-xs font-black uppercase tracking-widest text-rose-500">Guest favorite</p>
                    <p class="mt-2 text-2xl font-black"><%= secondHome ? secondHome.title : 'Luxury city stay' %></p>
                    <p class="mt-1 text-sm font-bold text-slate-500"><%= secondHome ? `${secondHome.city_name}, ${secondHome.country}` : 'Lahore, Pakistan' %></p>
                </div>

                <div class="absolute right-0 top-0 w-[86%] overflow-hidden rounded-[2.4rem] border border-white bg-white/70 p-4 shadow-2xl shadow-slate-300/70 backdrop-blur">
                    <div class="relative h-[520px] overflow-hidden rounded-[1.8rem] bg-gradient-to-br from-rose-100 via-amber-50 to-sky-100">
                        <% if (heroHome && heroHome.imageUrl) { %>
                            <img src="<%= heroHome.imageUrl %>" alt="<%= heroHome.title %>" class="h-full w-full object-cover">
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/15 to-transparent"></div>
                        <% } else { %>
                            <div class="flex h-full items-center justify-center px-8 text-center">
                                <div>
                                    <p class="text-xs font-black uppercase tracking-[0.3em] text-rose-500">Featured Stay</p>
                                    <h2 class="mt-3 text-4xl font-black text-slate-950">Beautiful homes, curated for comfort.</h2>
                                </div>
                            </div>
                        <% } %>

                        <% if (heroHome) { %>
                            <div class="absolute inset-x-5 bottom-5 rounded-3xl bg-white/90 p-5 shadow-xl backdrop-blur">
                                <div class="flex items-start justify-between gap-4">
                                    <div>
                                        <p class="text-xs font-black uppercase tracking-widest text-rose-500"><%= heroHome.property_type %></p>
                                        <h2 class="mt-1 text-2xl font-black"><%= heroHome.title %></h2>
                                        <p class="mt-1 text-sm font-bold text-slate-500"><%= heroHome.city_name %>, <%= heroHome.country %></p>
                                    </div>
                                    <div class="rounded-2xl bg-slate-950 px-4 py-3 text-right text-white">
                                        <p class="text-xs font-bold text-white/60">from</p>
                                        <p class="font-black">PKR <%= heroHome.price_per_night %></p>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="absolute bottom-8 left-0 z-30 rounded-[2rem] border border-white bg-slate-950 p-5 text-white shadow-2xl shadow-slate-300/70 animate-float-slow">
                    <p class="text-xs font-black uppercase tracking-widest text-white/50">Platform stats</p>
                    <div class="mt-3 grid grid-cols-3 gap-4">
                        <div><p class="text-2xl font-black"><%= safeHomes.length %>+</p><p class="text-xs text-white/50">Homes</p></div>
                        <div><p class="text-2xl font-black"><%= cityNames.length %>+</p><p class="text-xs text-white/50">Cities</p></div>
                        <div><p class="text-2xl font-black"><%= guestCapacity %>+</p><p class="text-xs text-white/50">Guests</p></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="featured" class="mx-auto my-12 max-w-6xl rounded-[2.5rem] border border-slate-300/80 bg-white/45 px-5 py-10 shadow-2xl shadow-slate-300/50 backdrop-blur-xl sm:px-6 reveal-on-scroll">
        <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
            <div>
                <p class="text-xs font-black uppercase tracking-[0.28em] text-rose-500">Featured homes</p>
                <h2 class="mt-2 text-3xl font-black sm:text-4xl">Explore standout stays</h2>
            </div>
            <div class="flex gap-2">
                <button type="button" data-carousel-prev class="h-12 w-12 rounded-full border border-slate-200 bg-white font-black text-slate-700 shadow-sm transition hover:-translate-y-0.5 hover:border-rose-200 hover:text-rose-600">‹</button>
                <button type="button" data-carousel-next class="h-12 w-12 rounded-full bg-slate-950 font-black text-white shadow-lg shadow-slate-200 transition hover:-translate-y-0.5 hover:bg-rose-500">›</button>
            </div>
        </div>

        <% if (errorMessage) { %>
            <div class="mb-8 rounded-2xl border border-rose-100 bg-rose-50 px-5 py-4 font-semibold text-rose-700"><%= errorMessage %></div>
        <% } %>

        <div data-home-carousel class="scrollbar-hide flex snap-x gap-5 overflow-x-auto scroll-smooth pb-6">
            <% if (safeHomes.length === 0) { %>
                <div class="min-w-full rounded-[2rem] border border-dashed border-slate-300 bg-white p-12 text-center">
                    <h3 class="text-2xl font-black">No homes available</h3>
                    <p class="mt-2 text-slate-500">Once hosts add homes, they will appear here.</p>
                </div>
            <% } %>

            <% safeHomes.forEach(home => { %>
                <article class="group min-w-[290px] snap-start overflow-hidden rounded-[1.75rem] border border-slate-300/80 bg-white/95 shadow-lg shadow-slate-300/50 transition-all duration-300 hover:-translate-y-2 hover:border-slate-400 hover:shadow-2xl hover:shadow-slate-300/70 md:min-w-[330px]">
                    <div class="relative h-52 overflow-hidden border-b border-slate-200 bg-gradient-to-br from-rose-50 via-amber-50 to-sky-100">
                        <% if (home.imageUrl) { %>
                            <img src="<%= home.imageUrl %>" alt="<%= home.title %>" class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/50 to-transparent"></div>
                        <% } else { %>
                            <div class="flex h-full items-center justify-center px-8 text-center">
                                <div>
                                    <p class="text-xs font-black uppercase tracking-[0.3em] text-rose-500"><%= home.property_type %></p>
                                    <h3 class="mt-3 text-2xl font-black"><%= home.title %></h3>
                                </div>
                            </div>
                        <% } %>
                        <span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1.5 text-[10px] font-black uppercase tracking-widest text-rose-500 shadow-sm transition group-hover:shadow-rose-100"><%= home.property_type %></span>
                        <span class="absolute right-4 top-4 rounded-full bg-slate-950/90 px-3 py-1.5 text-xs font-black text-white"><%= home.avg_rating || '0.00' %> rating</span>
                    </div>
                    <div class="p-5">
                        <h3 class="line-clamp-1 text-xl font-black"><%= home.title %></h3>
                        <p class="mt-1 text-sm font-bold text-slate-500"><%= home.city_name %>, <%= home.country %></p>
                        <p class="mt-3 text-xl font-black text-slate-950">PKR <%= home.price_per_night %> <span class="text-sm font-medium text-slate-400">/ night</span></p>
                        <div class="mt-3 flex flex-wrap gap-2 text-xs">
                            <span class="rounded-full bg-slate-100 px-3 py-1 font-bold text-slate-600"><%= home.max_guests %> guests</span>
                            <span class="rounded-full bg-slate-100 px-3 py-1 font-bold text-slate-600"><%= home.total_reviews %> reviews</span>
                        </div>
                        <% if (home.amenities) { %>
                            <p class="mt-3 line-clamp-2 text-sm leading-6 text-slate-500"><%= home.amenities %></p>
                        <% } %>
                    </div>
                </article>
            <% }) %>
        </div>
        <div class="mt-2 flex justify-center gap-2">
            <% safeHomes.slice(0, 5).forEach((home, index) => { %>
                <span class="h-2 w-8 rounded-full <%= index === 0 ? 'bg-rose-500' : 'bg-slate-200' %>"></span>
            <% }) %>
        </div>
    </section>

    <section class="bg-white py-16 reveal-on-scroll">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
            <div class="mb-8 text-center">
                <p class="text-xs font-black uppercase tracking-[0.28em] text-rose-500">Popular cities</p>
                <h2 class="mt-2 text-3xl font-black sm:text-4xl">Browse by destination</h2>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
                <% popularCities.forEach(city => { %>
                    <% const count = safeHomes.filter(home => home.city_name === city).length; %>
                    <div class="group relative min-h-48 overflow-hidden rounded-[2rem] bg-gradient-to-br from-slate-950 via-rose-950 to-orange-500 p-5 text-white shadow-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-slate-200">
                        <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.25),transparent_34%)] opacity-80"></div>
                        <div class="relative flex h-full flex-col justify-end">
                            <p class="text-2xl font-black"><%= city %></p>
                            <p class="mt-1 text-sm font-semibold text-white/70"><%= count > 0 ? `${count} home${count === 1 ? '' : 's'} available` : 'Premium destination' %></p>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 reveal-on-scroll">
        <div class="mb-8 text-center">
            <p class="text-xs font-black uppercase tracking-[0.28em] text-rose-500">Why choose StayEase</p>
            <h2 class="mt-2 text-3xl font-black sm:text-4xl">Built for confident travel</h2>
        </div>
        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
            <% [
                ['Verified properties', 'Clean listings with ratings, amenities, and host information.'],
                ['Smart availability', 'Blocked dates and bookings stay protected by the platform flow.'],
                ['Secure booking', 'Guests move through a clear, guided reservation experience.'],
                ['Host earnings', 'Hosts manage homes, bookings, availability, and revenue.']
            ].forEach((item, index) => { %>
                <div class="group rounded-[2rem] border border-slate-200 bg-white p-7 shadow-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-slate-200">
                    <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-rose-100 to-orange-100 text-xl font-black text-rose-500 transition group-hover:scale-110"><%= index + 1 %></div>
                    <h3 class="text-xl font-black"><%= item[0] %></h3>
                    <p class="mt-3 leading-7 text-slate-500"><%= item[1] %></p>
                </div>
            <% }) %>
        </div>
    </section>

    <section class="bg-slate-950 py-16 text-white reveal-on-scroll">
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
            <div class="mb-10 text-center">
                <p class="text-xs font-black uppercase tracking-[0.28em] text-rose-300">How it works</p>
                <h2 class="mt-2 text-3xl font-black sm:text-4xl">Three steps to your next stay</h2>
            </div>
            <div class="grid gap-5 md:grid-cols-3">
                <% [
                    ['Search your destination', 'Choose a city, dates, guest count, and budget.'],
                    ['Book your stay', 'Review details and reserve with a simple booking flow.'],
                    ['Enjoy your trip', 'Arrive with confidence and message your host anytime.']
                ].forEach((step, index) => { %>
                    <div class="relative rounded-[2rem] border border-white/10 bg-white/5 p-7 transition hover:-translate-y-2 hover:bg-white/10">
                        <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-rose-500 text-2xl font-black"><%= index + 1 %></div>
                        <h3 class="text-xl font-black"><%= step[0] %></h3>
                        <p class="mt-3 leading-7 text-white/60"><%= step[1] %></p>
                    </div>
                <% }) %>
            </div>
        </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 reveal-on-scroll">
        <div class="grid gap-4 md:grid-cols-4">
            <div class="rounded-[2rem] border border-slate-200 bg-white p-6 text-center shadow-sm"><p class="text-4xl font-black"><%= safeHomes.length %>+</p><p class="mt-2 text-xs font-black uppercase tracking-widest text-slate-400">Total homes</p></div>
            <div class="rounded-[2rem] border border-slate-200 bg-white p-6 text-center shadow-sm"><p class="text-4xl font-black"><%= cityNames.length %>+</p><p class="mt-2 text-xs font-black uppercase tracking-widest text-slate-400">Active cities</p></div>
            <div class="rounded-[2rem] border border-slate-200 bg-white p-6 text-center shadow-sm"><p class="text-4xl font-black"><%= guestCapacity %>+</p><p class="mt-2 text-xs font-black uppercase tracking-widest text-slate-400">Happy guests</p></div>
            <div class="rounded-[2rem] border border-slate-200 bg-white p-6 text-center shadow-sm"><p class="text-4xl font-black"><%= reviewCount %>+</p><p class="mt-2 text-xs font-black uppercase tracking-widest text-slate-400">Successful stays</p></div>
        </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 reveal-on-scroll">
        <div class="relative overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-rose-500 via-orange-400 to-sky-400 p-8 text-white shadow-2xl shadow-rose-200 sm:p-12 animate-gradient-x">
            <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-white/20 blur-3xl"></div>
            <div class="relative flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
                <div>
                    <p class="text-xs font-black uppercase tracking-[0.28em] text-white/70">Start your journey</p>
                    <h2 class="mt-3 max-w-2xl text-4xl font-black sm:text-5xl">Ready to find your next stay?</h2>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <a href="#featured" class="rounded-2xl bg-white px-7 py-4 text-center font-black text-slate-950 transition hover:-translate-y-1">Browse Homes</a>
                    <a href="/signup" class="rounded-2xl bg-slate-950 px-7 py-4 text-center font-black text-white transition hover:-translate-y-1">Create Account</a>
                </div>
            </div>
        </div>
    </section>
</main>

<footer class="border-t border-slate-200 bg-slate-950 text-white">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-[1fr_auto] md:items-center">
        <div>
            <p class="text-2xl font-black">StayEase</p>
            <p class="mt-2 max-w-lg text-sm leading-6 text-white/60">Premium Airbnb-style stays with modern MVC, EJS, Tailwind, and MySQL.</p>
        </div>
        <div class="flex flex-wrap gap-3">
            <a href="/" class="rounded-full bg-white/10 px-5 py-3 text-sm font-black transition hover:bg-white hover:text-slate-950">Homes</a>
            <a href="/login" class="rounded-full bg-white/10 px-5 py-3 text-sm font-black transition hover:bg-white hover:text-slate-950">Login</a>
            <a href="/signup" class="rounded-full bg-rose-500 px-5 py-3 text-sm font-black transition hover:bg-rose-600">Signup</a>
        </div>
    </div>
    <div class="border-t border-white/10 px-4 py-5 text-center text-xs font-semibold text-white/40">Copyright 2026 StayEase. All rights reserved.</div>
</footer>

<script>
    const carousel = document.querySelector('[data-home-carousel]');
    const nextButton = document.querySelector('[data-carousel-next]');
    const prevButton = document.querySelector('[data-carousel-prev]');

    if (carousel && nextButton && prevButton) {
        nextButton.addEventListener('click', () => carousel.scrollBy({ left: 350, behavior: 'smooth' }));
        prevButton.addEventListener('click', () => carousel.scrollBy({ left: -350, behavior: 'smooth' }));
        setInterval(() => {
            if (carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 8) {
                carousel.scrollTo({ left: 0, behavior: 'smooth' });
            } else {
                carousel.scrollBy({ left: 350, behavior: 'smooth' });
            }
        }, 5000);
    }

    const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
            }
        });
    }, { threshold: 0.12 });

    document.querySelectorAll('.reveal-on-scroll').forEach(section => observer.observe(section));
</script>

</body>
</html>
