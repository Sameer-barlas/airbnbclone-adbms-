<%- include('../partials/head') %>

<body class="min-h-screen bg-gradient-to-br from-slate-100 via-sky-50/70 to-orange-50/60 text-slate-950">
<%- include('../partials/navbar') %>

<main class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,rgba(244,63,94,0.055),transparent_30%),radial-gradient(circle_at_85%_25%,rgba(251,146,60,0.11),transparent_32%),radial-gradient(circle_at_52%_75%,rgba(14,165,233,0.12),transparent_36%)]"></div>
    <div class="pointer-events-none absolute -left-28 top-20 h-96 w-96 rounded-full bg-rose-200/45 blur-3xl animate-float-slow"></div>
    <div class="pointer-events-none absolute right-0 top-72 h-96 w-96 rounded-full bg-sky-200/40 blur-3xl animate-float-slow"></div>

    <section class="relative mx-auto max-w-3xl px-4 py-10 sm:px-6">
        <div class="mb-6 overflow-hidden rounded-[2.5rem] border border-white bg-gradient-to-br from-slate-950 via-slate-900 to-rose-950 p-6 text-white shadow-2xl shadow-slate-300/70 animate-gradient-x">
            <p class="text-xs font-black uppercase tracking-[0.28em] text-rose-200">Conversation</p>
            <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">Messages</h1>
        </div>

        <div class="reveal-on-scroll overflow-hidden rounded-[2rem] border border-white bg-white shadow-2xl shadow-slate-200/70">
            <div class="max-h-[560px] space-y-4 overflow-auto bg-gradient-to-br from-rose-50 via-white to-sky-50 p-6">
                <% if (!messages || messages.length === 0) { %>
                    <p class="rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500">No conversation yet.</p>
                <% } %>
                <% messages.forEach(message => { %>
                    <div class="<%= message.sender_id === currentUser.user_id ? 'ml-auto bg-rose-500 text-white shadow-lg shadow-rose-100' : 'mr-auto bg-white text-slate-800 shadow-sm' %> max-w-[85%] rounded-3xl px-5 py-3">
                        <p class="text-xs font-black opacity-70"><%= message.sender_name %></p>
                        <p class="mt-1 leading-7"><%= message.body %></p>
                    </div>
                <% }) %>
            </div>

            <form action="/messages" method="POST" class="space-y-3 border-t border-slate-100 bg-white p-5">
                <input type="hidden" name="receiverId" value="<%= otherUserId %>">
                <input type="hidden" name="redirectTo" value="/messages/<%= otherUserId %>">
                <textarea name="body" rows="3" required placeholder="Type your reply..." class="w-full rounded-2xl border border-slate-200 px-4 py-3 outline-none transition focus:border-rose-300 focus:ring-4 focus:ring-rose-100"></textarea>
                <button class="rounded-2xl bg-rose-500 px-8 py-3 font-black text-white shadow-lg shadow-rose-100 transition hover:-translate-y-0.5 hover:bg-rose-600">Send</button>
            </form>
        </div>
    </section>
</main>

</body>
</html>
