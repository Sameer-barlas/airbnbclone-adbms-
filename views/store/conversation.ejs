<%- include('../partials/head') %>

<body class="min-h-screen bg-slate-50 text-slate-900">
<%- include('../partials/navbar') %>

<main class="max-w-3xl mx-auto px-6 py-10">
    <h1 class="text-4xl font-black mb-8">Conversation</h1>
    <div class="bg-white border border-slate-200 rounded-3xl p-6 space-y-4">
        <% if (!messages || messages.length === 0) { %>
            <p class="text-slate-500 text-center py-8">No conversation yet.</p>
        <% } %>
        <% messages.forEach(message => { %>
            <div class="<%= message.sender_id === currentUser.user_id ? 'ml-auto bg-rose-500 text-white' : 'mr-auto bg-slate-100 text-slate-800' %> max-w-[80%] rounded-3xl px-5 py-3">
                <p class="text-xs font-black opacity-70"><%= message.sender_name %></p>
                <p class="mt-1"><%= message.body %></p>
            </div>
        <% }) %>

        <form action="/messages" method="POST" class="pt-4 border-t border-slate-100 space-y-3">
            <input type="hidden" name="receiverId" value="<%= otherUserId %>">
            <input type="hidden" name="redirectTo" value="/messages/<%= otherUserId %>">
            <textarea name="body" rows="3" required placeholder="Type your reply..." class="w-full rounded-2xl border border-slate-200 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-rose-100"></textarea>
            <button class="bg-rose-500 text-white px-8 py-3 rounded-2xl font-black">Send</button>
        </form>
    </div>
</main>

</body>
</html>
