<%- include('../partials/head') %>

<body class="min-h-screen bg-gradient-to-br from-slate-100 via-sky-50/70 to-orange-50/60 text-slate-950">
<%- include('../partials/navbar') %>

<main class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,rgba(244,63,94,0.055),transparent_30%),radial-gradient(circle_at_85%_25%,rgba(251,146,60,0.11),transparent_32%),radial-gradient(circle_at_52%_75%,rgba(14,165,233,0.12),transparent_36%)]"></div>
    <div class="pointer-events-none absolute -left-28 top-20 h-96 w-96 rounded-full bg-rose-200/45 blur-3xl animate-float-slow"></div>
    <div class="pointer-events-none absolute right-0 top-80 h-96 w-96 rounded-full bg-cyan-100/50 blur-3xl animate-float-slow"></div>
    <div class="pointer-events-none absolute bottom-32 left-1/2 h-80 w-80 rounded-full bg-orange-200/40 blur-3xl"></div>

    <section class="relative z-10 mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <% if (!currentHome) { %>
            <div class="rounded-[2rem] border border-white bg-white/85 p-12 text-center shadow-2xl shadow-slate-200/70 backdrop-blur-xl">
                <h1 class="text-3xl font-black">Home not found</h1>
                <a href="/" class="mt-6 inline-block rounded-2xl bg-rose-500 px-6 py-3 font-bold text-white shadow-lg shadow-rose-100 transition hover:-translate-y-0.5 hover:bg-rose-600">Back to listings</a>
            </div>
        <% } else { %>
            <% const amenityList = currentHome.amenities ? String(currentHome.amenities).split(',').map(item => item.trim()).filter(Boolean) : []; %>

            <% if (message) { %>
                <div class="mb-6 rounded-2xl border border-emerald-100 bg-emerald-50 px-5 py-4 text-emerald-700 font-semibold shadow-sm"><%= message %></div>
            <% } %>

            <section class="overflow-hidden rounded-[2.75rem] border border-white bg-white/85 shadow-2xl shadow-slate-200/70 backdrop-blur-xl">
                <div class="relative h-[28rem] overflow-hidden bg-gradient-to-br from-rose-100 via-amber-50 to-sky-100">
                    <% if (currentHome.imageUrl) { %>
                        <img src="<%= currentHome.imageUrl %>" alt="<%= currentHome.title %>" class="absolute inset-0 h-full w-full object-cover">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>
                    <% } else { %>
                        <div class="absolute inset-0 animate-shimmer"></div>
                        <div class="absolute inset-0 bg-[radial-gradient(circle_at_25%_20%,rgba(244,63,94,0.18),transparent_35%),radial-gradient(circle_at_80%_30%,rgba(251,146,60,0.20),transparent_32%),radial-gradient(circle_at_55%_85%,rgba(14,165,233,0.18),transparent_35%)]"></div>
                    <% } %>

                    <div class="absolute left-5 right-5 top-5 flex flex-wrap items-center justify-between gap-3">
                        <span class="rounded-full bg-white/90 px-4 py-2 text-xs font-black uppercase tracking-widest text-rose-500 shadow-sm backdrop-blur"><%= currentHome.property_type %></span>
                        <span class="rounded-full bg-slate-950/90 px-4 py-2 text-sm font-black text-white shadow-sm"><%= currentHome.avg_rating || '0.00' %> rating | <%= currentHome.total_reviews || 0 %> reviews</span>
                    </div>

                    <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8 lg:p-10">
                        <p class="text-xs font-black uppercase tracking-[0.28em] <%= currentHome.imageUrl ? 'text-rose-100' : 'text-rose-500' %>">Premium stay</p>
                        <h1 class="mt-3 max-w-4xl text-5xl font-black tracking-tight <%= currentHome.imageUrl ? 'text-white drop-shadow' : 'text-slate-950' %> sm:text-6xl"><%= currentHome.title %></h1>
                        <p class="mt-3 text-lg font-bold <%= currentHome.imageUrl ? 'text-white/85' : 'text-slate-600' %>"><%= currentHome.city_name %>, <%= currentHome.country %></p>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-8 p-6 sm:p-8 lg:grid-cols-[1fr_360px] lg:p-10">
                    <div class="space-y-8">
                        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
                            <div class="rounded-3xl border border-slate-100 bg-slate-50/80 p-4">
                                <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Guests</p>
                                <p class="mt-1 text-2xl font-black"><%= currentHome.max_guests %></p>
                            </div>
                            <div class="rounded-3xl border border-slate-100 bg-slate-50/80 p-4">
                                <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Rooms</p>
                                <p class="mt-1 text-2xl font-black"><%= currentHome.total_rooms %></p>
                            </div>
                            <div class="rounded-3xl border border-slate-100 bg-slate-50/80 p-4">
                                <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Rating</p>
                                <p class="mt-1 text-2xl font-black"><%= currentHome.avg_rating || '0.00' %></p>
                            </div>
                            <div class="rounded-3xl border border-slate-100 bg-slate-50/80 p-4">
                                <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Reviews</p>
                                <p class="mt-1 text-2xl font-black"><%= currentHome.total_reviews || 0 %></p>
                            </div>
                        </div>

                        <section class="rounded-[2rem] border border-slate-100 bg-white/80 p-6 shadow-sm">
                            <h2 class="text-2xl font-black">About this home</h2>
                            <p class="mt-3 leading-8 text-slate-600"><%= currentHome.description || 'No description added yet.' %></p>
                        </section>

                        <section class="rounded-[2rem] border border-slate-100 bg-white/80 p-6 shadow-sm">
                            <h3 class="text-2xl font-black">Amenities</h3>
                            <div class="mt-4 flex flex-wrap gap-2">
                                <% if (amenityList.length === 0) { %>
                                    <span class="rounded-full bg-slate-100 px-4 py-2 text-sm font-bold text-slate-500">No amenities listed.</span>
                                <% } %>
                                <% amenityList.forEach(amenity => { %>
                                    <span class="rounded-full border border-rose-100 bg-rose-50 px-4 py-2 text-sm font-bold text-rose-600"><%= amenity %></span>
                                <% }) %>
                            </div>
                        </section>

                        <section class="rounded-[2rem] border border-slate-100 bg-white/80 p-6 shadow-sm">
                            <h3 class="text-2xl font-black">Reviews</h3>
                            <div class="mt-4 space-y-4">
                                <% if (!reviews || reviews.length === 0) { %>
                                    <p class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 p-5 text-slate-500">No reviews yet.</p>
                                <% } %>
                                <% reviews.forEach(review => { %>
                                    <div class="rounded-2xl border border-slate-100 bg-slate-50/80 p-4 transition hover:bg-rose-50">
                                        <div class="flex justify-between gap-4">
                                            <p class="font-black"><%= review.guest_name %></p>
                                            <p class="font-black text-amber-600"><%= review.rating %>/5</p>
                                        </div>
                                        <p class="mt-2 text-slate-600"><%= review.comment || 'No comment.' %></p>
                                    </div>
                                <% }) %>
                            </div>
                        </section>
                    </div>

                    <aside class="h-fit rounded-[2rem] border border-white bg-white/90 p-6 shadow-2xl shadow-slate-200/70 backdrop-blur-xl lg:sticky lg:top-28">
                        <div class="rounded-3xl bg-gradient-to-br from-rose-50 via-white to-orange-50 p-5">
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Hosted by</p>
                            <p class="mt-1 text-xl font-black"><%= currentHome.host_name %></p>
                            <p class="mt-6 text-[10px] font-black uppercase tracking-widest text-rose-400">Price per night</p>
                            <p class="mt-1 text-4xl font-black text-rose-600">PKR <%= currentHome.price_per_night %></p>
                        </div>

                        <% if (isGuest) { %>
                            <a href="/book/<%= currentHome.property_id %>" class="animate-pulse-soft mt-6 block rounded-2xl bg-rose-500 py-4 text-center font-black text-white shadow-xl shadow-rose-100 transition hover:-translate-y-1 hover:bg-rose-600">Reserve</a>
                            <form action="/addtofavourites" method="POST" class="mt-3">
                                <input type="hidden" name="propertyId" value="<%= currentHome.property_id %>">
                                <button class="w-full rounded-2xl bg-slate-950 py-4 font-black text-white transition hover:-translate-y-0.5 hover:bg-slate-800">Add to Favourites</button>
                            </form>
                            <form action="/messages" method="POST" class="mt-6 space-y-3 rounded-3xl border border-slate-100 bg-slate-50 p-4">
                                <input type="hidden" name="receiverId" value="<%= currentHome.host_id %>">
                                <input type="hidden" name="propertyId" value="<%= currentHome.property_id %>">
                                <input type="hidden" name="redirectTo" value="/homedetails/<%= currentHome.property_id %>?message=Message sent.">
                                <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Message host</label>
                                <textarea name="body" rows="3" required placeholder="Ask about the stay..." class="w-full rounded-2xl border border-slate-200 bg-white/80 px-4 py-3 outline-none transition focus:border-rose-400 focus:ring-4 focus:ring-rose-100"></textarea>
                                <button class="w-full rounded-2xl border border-slate-200 bg-white py-3 font-bold transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-600">Send Message</button>
                            </form>
                        <% } %>
                    </aside>
                </div>
            </section>
        <% } %>
    </section>
</main>

</body>
</html>
