<%- include('../partials/head') %>

<body class="min-h-screen bg-slate-50 text-slate-900">
<%- include('../partials/navbar') %>

<main class="max-w-6xl mx-auto px-6 py-10">
    <% if (!currentHome) { %>
        <div class="bg-white border border-slate-200 rounded-3xl p-12 text-center">
            <h1 class="text-3xl font-black">Home not found</h1>
            <a href="/" class="mt-6 inline-block bg-rose-500 text-white px-6 py-3 rounded-2xl font-bold">Back to listings</a>
        </div>
    <% } else { %>
        <% if (message) { %>
            <div class="mb-6 rounded-2xl border border-emerald-100 bg-emerald-50 px-5 py-4 text-emerald-700 font-semibold"><%= message %></div>
        <% } %>

        <section class="bg-white border border-slate-200 rounded-[2rem] overflow-hidden shadow-xl">
            <div class="relative h-72 bg-gradient-to-br from-rose-100 via-amber-50 to-sky-100 flex items-center justify-center text-center px-8 overflow-hidden">
                <% if (currentHome.imageUrl) { %>
                    <img src="<%= currentHome.imageUrl %>" alt="<%= currentHome.title %>" class="absolute inset-0 w-full h-full object-cover">
                    <div class="absolute inset-0 bg-slate-950/35"></div>
                <% } %>
                <div>
                    <p class="relative text-xs font-black uppercase tracking-[0.3em] <%= currentHome.imageUrl ? 'text-white' : 'text-rose-500' %>"><%= currentHome.property_type %></p>
                    <h1 class="relative text-4xl md:text-6xl font-black <%= currentHome.imageUrl ? 'text-white drop-shadow' : 'text-slate-900' %> mt-3"><%= currentHome.title %></h1>
                    <p class="relative <%= currentHome.imageUrl ? 'text-white/90' : 'text-slate-500' %> font-bold mt-3"><%= currentHome.city_name %>, <%= currentHome.country %></p>
                </div>
            </div>

            <div class="p-8 md:p-10 grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-10">
                <div>
                    <div class="flex flex-wrap gap-3 mb-8">
                        <span class="bg-slate-100 px-4 py-2 rounded-full text-sm font-bold"><%= currentHome.max_guests %> guests</span>
                        <span class="bg-slate-100 px-4 py-2 rounded-full text-sm font-bold"><%= currentHome.total_rooms %> rooms</span>
                        <span class="bg-slate-100 px-4 py-2 rounded-full text-sm font-bold"><%= currentHome.avg_rating %> rating</span>
                        <span class="bg-slate-100 px-4 py-2 rounded-full text-sm font-bold"><%= currentHome.total_reviews %> reviews</span>
                    </div>

                    <h2 class="text-2xl font-black mb-3">About this home</h2>
                    <p class="text-slate-600 leading-8"><%= currentHome.description || 'No description added yet.' %></p>

                    <h3 class="text-xl font-black mt-8 mb-3">Amenities</h3>
                    <p class="text-slate-600"><%= currentHome.amenities || 'No amenities listed.' %></p>

                    <h3 class="text-xl font-black mt-8 mb-4">Reviews</h3>
                    <div class="space-y-4">
                        <% if (!reviews || reviews.length === 0) { %>
                            <p class="text-slate-500">No reviews yet.</p>
                        <% } %>
                        <% reviews.forEach(review => { %>
                            <div class="border border-slate-100 rounded-2xl p-4">
                                <div class="flex justify-between gap-4">
                                    <p class="font-black"><%= review.guest_name %></p>
                                    <p class="text-amber-600 font-black"><%= review.rating %>/5</p>
                                </div>
                                <p class="text-slate-600 mt-2"><%= review.comment || 'No comment.' %></p>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <aside class="bg-slate-50 border border-slate-100 rounded-3xl p-6 h-fit">
                    <p class="text-[10px] font-black uppercase tracking-widest text-slate-400">Hosted by</p>
                    <p class="text-xl font-black mt-1"><%= currentHome.host_name %></p>
                    <p class="text-3xl font-black text-rose-500 mt-6">PKR <%= currentHome.price_per_night %></p>
                    <p class="text-slate-500 text-sm">per night</p>

                    <% if (isGuest) { %>
                        <a href="/book/<%= currentHome.property_id %>" class="mt-6 block text-center bg-rose-500 text-white py-4 rounded-2xl font-black hover:bg-rose-600 transition">Reserve</a>
                        <form action="/addtofavourites" method="POST" class="mt-3">
                            <input type="hidden" name="propertyId" value="<%= currentHome.property_id %>">
                            <button class="w-full bg-slate-900 text-white py-4 rounded-2xl font-black hover:bg-slate-800 transition">Add to Favourites</button>
                        </form>
                        <form action="/messages" method="POST" class="mt-6 space-y-3">
                            <input type="hidden" name="receiverId" value="<%= currentHome.host_id %>">
                            <input type="hidden" name="propertyId" value="<%= currentHome.property_id %>">
                            <input type="hidden" name="redirectTo" value="/homedetails/<%= currentHome.property_id %>?message=Message sent.">
                            <textarea name="body" rows="3" required placeholder="Message the host..." class="w-full rounded-2xl border border-slate-200 px-4 py-3 focus:outline-none focus:ring-4 focus:ring-rose-100"></textarea>
                            <button class="w-full border border-slate-200 py-3 rounded-2xl font-bold hover:bg-white transition">Send Message</button>
                        </form>
                    <% } %>
                </aside>
            </div>
        </section>
    <% } %>
</main>

</body>
</html>
