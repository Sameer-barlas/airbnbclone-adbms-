# Rentza Environment Configuration

# Server Port (Render sets this automatically)
PORT=3000

# -------------------------------------------------------------
# TiDB Cloud Configuration (Recommended)
# Sign up at https://tidbcloud.com, create a free Serverless cluster.
# TiDB Cloud default port is 4000 and SSL is required.
# -------------------------------------------------------------
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_prefix.root
DB_PASSWORD=your_tidb_password
DB_NAME=air_bnb
DB_SSL=true

# Or use the single DATABASE_URL string provided by TiDB Cloud / Render:
# DATABASE_URL=mysql://your_prefix.root:your_password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/air_bnb?ssl={"rejectUnauthorized":true}

# -------------------------------------------------------------
# Local MySQL Configuration (Alternative)
# -------------------------------------------------------------
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=root
# DB_NAME=air_bnb
# DB_SSL=false

# -------------------------------------------------------------
# Authentication & Security
# -------------------------------------------------------------
JWT_SECRET=stayease-super-secret-jwt-key-change-in-production
